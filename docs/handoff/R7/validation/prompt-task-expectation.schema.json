{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sastsimi.local/schemas/r7-prompt-task-expectation.v1.json",
  "title": "R7 prompt task validation expectations",
  "type": "object",
  "required": [
    "expectation_schema_version",
    "suite_id",
    "task_kind",
    "output_schema",
    "semantic_validator",
    "result_kind",
    "cases",
    "must_not_claim"
  ],
  "properties": {
    "expectation_schema_version": {"const": "r7-prompt-task-expectation.v1"},
    "suite_id": {"type": "string", "minLength": 1},
    "task_kind": {
      "enum": [
        "DERIVE_ENVIRONMENT",
        "PLAN_REPRODUCTION",
        "CREATE_POC_CANDIDATE",
        "EXECUTE_REPRODUCTION",
        "INTERPRET_ATTEMPT"
      ]
    },
    "output_schema": {"type": "string", "minLength": 1},
    "semantic_validator": {"type": "string", "minLength": 1},
    "result_kind": {"type": "string", "minLength": 1},
    "cases": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["scenario_id", "expected_disposition", "required_checks"],
        "properties": {
          "scenario_id": {"type": "string", "minLength": 1},
          "expected_disposition": {
            "enum": [
              "ACCEPT_OUTPUT",
              "REJECT_SCHEMA",
              "REJECT_SEMANTIC",
              "BLOCK_STALE_INPUT"
            ]
          },
          "required_checks": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "runtime_block_reason": {
            "type": ["string", "null"]
          }
        },
        "additionalProperties": false
      }
    },
    "must_not_claim": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false
}
