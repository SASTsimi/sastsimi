{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sastsimi.local/schemas/r7-validation-case.v1.json",
  "title": "R7 validation case draft",
  "type": "object",
  "required": ["case_schema_version", "case_id", "case_layer", "source", "scope"],
  "properties": {
    "case_schema_version": {"const": "r7-validation-case.v1"},
    "case_id": {"type": "string", "minLength": 1},
    "case_layer": {"enum": ["LLM_AND_RUNTIME_INTEGRATION", "TRUSTED_RUNTIME_INTEGRATION"]},
    "source": {"type": "object"},
    "scope": {
      "type": "object",
      "required": ["analysis_id", "workspace_id", "commit_id", "hypothesis_id", "verification_generation", "work_id", "attempt_id"]
    },
    "records": {"type": "object"},
    "steps": {"type": "array"},
    "completed_execution_log": {"type": "object"},
    "stimulus": {"type": "object"}
  },
  "additionalProperties": false
}
