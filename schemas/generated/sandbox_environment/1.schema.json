{
  "$defs": {
    "AnalysisId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "AnalysisId",
      "type": "string"
    },
    "AttemptId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "AttemptId",
      "type": "string"
    },
    "CommitId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "CommitId",
      "type": "string"
    },
    "EnvironmentCheck": {
      "additionalProperties": false,
      "properties": {
        "actual": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Actual"
        },
        "actual_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/StoredDataRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "check_result_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/StoredDataRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "difference": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Difference"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/StoredDataRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "requirement_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Requirement Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "MATCH",
            "MISMATCH",
            "NOT_CHECKED",
            "ERROR"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "requirement_id",
        "status",
        "actual",
        "actual_ref",
        "difference",
        "evidence_refs",
        "check_result_ref"
      ],
      "title": "EnvironmentCheck",
      "type": "object"
    },
    "HypothesisId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "HypothesisId",
      "type": "string"
    },
    "LogicalRecordId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "LogicalRecordId",
      "type": "string"
    },
    "RecordId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "RecordId",
      "type": "string"
    },
    "RecordMeta": {
      "additionalProperties": false,
      "properties": {
        "analysis_id": {
          "$ref": "#/$defs/AnalysisId"
        },
        "attempt_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/AttemptId"
            },
            {
              "type": "null"
            }
          ]
        },
        "commit_id": {
          "$ref": "#/$defs/CommitId"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "hypothesis_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/HypothesisId"
            },
            {
              "type": "null"
            }
          ]
        },
        "logical_record_id": {
          "$ref": "#/$defs/LogicalRecordId"
        },
        "previous_record_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecordId"
            },
            {
              "type": "null"
            }
          ]
        },
        "record_id": {
          "$ref": "#/$defs/RecordId"
        },
        "record_type": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Record Type",
          "type": "string"
        },
        "revision_number": {
          "minimum": 1,
          "title": "Revision Number",
          "type": "integer"
        },
        "schema_version": {
          "pattern": "^[1-9][0-9]*\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Schema Version",
          "type": "string"
        },
        "workspace_id": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "record_id",
        "logical_record_id",
        "record_type",
        "schema_version",
        "revision_number",
        "previous_record_id",
        "created_at",
        "analysis_id",
        "workspace_id",
        "commit_id",
        "hypothesis_id",
        "attempt_id"
      ],
      "title": "RecordMeta",
      "type": "object"
    },
    "StoredDataId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "StoredDataId",
      "type": "string"
    },
    "StoredDataRef": {
      "additionalProperties": false,
      "properties": {
        "commit_id": {
          "$ref": "#/$defs/CommitId"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "data_kind": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Data Kind",
          "type": "string"
        },
        "record_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecordId"
            },
            {
              "type": "null"
            }
          ]
        },
        "stored_data_id": {
          "$ref": "#/$defs/StoredDataId"
        },
        "workspace_id": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "stored_data_id",
        "data_kind",
        "content_hash",
        "workspace_id",
        "commit_id",
        "record_id"
      ],
      "title": "StoredDataRef",
      "type": "object"
    },
    "WorkspaceId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "WorkspaceId",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "checks": {
      "items": {
        "$ref": "#/$defs/EnvironmentCheck"
      },
      "title": "Checks",
      "type": "array"
    },
    "container_action": {
      "enum": [
        "CREATED",
        "REUSED"
      ],
      "title": "Container Action",
      "type": "string"
    },
    "container_instance_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Container Instance Id",
      "type": "string"
    },
    "container_reason": {
      "enum": [
        "INITIAL_CLEAN",
        "NO_RELEVANT_CHANGE",
        "STATE_CHANGED",
        "CONFIG_CHANGED",
        "STATE_UNCERTAIN"
      ],
      "title": "Container Reason",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "environment_recipe_ref": {
      "$ref": "#/$defs/StoredDataRef"
    },
    "limitations": {
      "items": {
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "meta": {
      "$ref": "#/$defs/RecordMeta"
    },
    "previous_environment_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/StoredDataRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "reproduction_plan_ref": {
      "$ref": "#/$defs/StoredDataRef"
    },
    "request_ref": {
      "$ref": "#/$defs/StoredDataRef"
    },
    "requirements_ref": {
      "$ref": "#/$defs/StoredDataRef"
    },
    "status": {
      "enum": [
        "READY",
        "MISMATCH",
        "ERROR"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "meta",
    "request_ref",
    "reproduction_plan_ref",
    "environment_recipe_ref",
    "requirements_ref",
    "container_instance_id",
    "container_action",
    "container_reason",
    "previous_environment_ref",
    "status",
    "checks",
    "limitations",
    "created_at"
  ],
  "title": "SandboxEnvironment",
  "type": "object"
}
