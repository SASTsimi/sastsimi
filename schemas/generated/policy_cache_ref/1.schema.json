{
  "$defs": {
    "ProgramId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "ProgramId",
      "type": "string"
    },
    "RecordId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "RecordId",
      "type": "string"
    },
    "StoredDataId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "StoredDataId",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "data_kind": {
      "const": "policy_cache_record",
      "title": "Data Kind",
      "type": "string"
    },
    "program_id": {
      "$ref": "#/$defs/ProgramId"
    },
    "record_id": {
      "$ref": "#/$defs/RecordId"
    },
    "schema_version": {
      "pattern": "^[1-9][0-9]*\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "title": "Schema Version",
      "type": "string"
    },
    "stored_data_id": {
      "$ref": "#/$defs/StoredDataId"
    }
  },
  "required": [
    "stored_data_id",
    "data_kind",
    "record_id",
    "content_hash",
    "program_id",
    "schema_version"
  ],
  "title": "PolicyCacheRef",
  "type": "object"
}
