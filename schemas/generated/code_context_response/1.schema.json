{
  "$defs": {
    "AnalysisError": {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/AttemptId"
            },
            {
              "type": "null"
            }
          ]
        },
        "code": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Code",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "error_id": {
          "$ref": "#/$defs/ErrorId"
        },
        "related_record_ids": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Related Record Ids",
          "type": "array"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "safe_message": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Safe Message",
          "type": "string"
        },
        "stage": {
          "enum": [
            "INPUT",
            "REPOSITORY",
            "STATIC_ANALYSIS",
            "CONTEXT",
            "ORCHESTRATION",
            "AGENT",
            "PROVIDER",
            "SANDBOX",
            "POLICY",
            "GATE",
            "REPORT",
            "STATE",
            "STORAGE",
            "RECOVERY",
            "AUTHORITY"
          ],
          "title": "Stage",
          "type": "string"
        },
        "work_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "error_id",
        "stage",
        "code",
        "safe_message",
        "retryable",
        "work_id",
        "attempt_id",
        "related_record_ids",
        "created_at"
      ],
      "title": "AnalysisError",
      "type": "object"
    },
    "AnalysisId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "AnalysisId",
      "type": "string"
    },
    "AttemptId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "AttemptId",
      "type": "string"
    },
    "CodeLocation": {
      "additionalProperties": false,
      "properties": {
        "commit_id": {
          "$ref": "#/$defs/CommitId"
        },
        "end_column": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "End Column"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "file_path": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "File Path",
          "type": "string"
        },
        "start_column": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Start Column"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        },
        "workspace_id": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "workspace_id",
        "commit_id",
        "file_path",
        "start_line",
        "start_column",
        "end_line",
        "end_column"
      ],
      "title": "CodeLocation",
      "type": "object"
    },
    "CodeRelation": {
      "additionalProperties": false,
      "properties": {
        "from_location": {
          "$ref": "#/$defs/CodeLocation"
        },
        "from_symbol_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "From Symbol Id"
        },
        "producer": {
          "$ref": "#/$defs/ToolSource"
        },
        "relation_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Relation Id",
          "type": "string"
        },
        "relation_kind": {
          "enum": [
            "CALL",
            "DATA_FLOW",
            "IMPORT",
            "INHERITANCE",
            "ROUTE_BINDING",
            "OTHER"
          ],
          "title": "Relation Kind",
          "type": "string"
        },
        "to_location": {
          "$ref": "#/$defs/CodeLocation"
        },
        "to_symbol_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "To Symbol Id"
        }
      },
      "required": [
        "relation_id",
        "relation_kind",
        "from_symbol_id",
        "from_location",
        "to_symbol_id",
        "to_location",
        "producer"
      ],
      "title": "CodeRelation",
      "type": "object"
    },
    "CodeSymbol": {
      "additionalProperties": false,
      "properties": {
        "location": {
          "$ref": "#/$defs/CodeLocation"
        },
        "name": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Name",
          "type": "string"
        },
        "native_kind": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Native Kind"
        },
        "symbol_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Symbol Id",
          "type": "string"
        },
        "symbol_kind": {
          "enum": [
            "FILE",
            "MODULE",
            "TYPE",
            "CALLABLE",
            "DATA",
            "ROUTE",
            "CONFIG"
          ],
          "title": "Symbol Kind",
          "type": "string"
        }
      },
      "required": [
        "symbol_id",
        "symbol_kind",
        "native_kind",
        "name",
        "location"
      ],
      "title": "CodeSymbol",
      "type": "object"
    },
    "CommitId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "CommitId",
      "type": "string"
    },
    "DataGap": {
      "additionalProperties": false,
      "properties": {
        "affected_languages": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Affected Languages",
          "type": "array"
        },
        "affected_locations": {
          "items": {
            "$ref": "#/$defs/CodeLocation"
          },
          "title": "Affected Locations",
          "type": "array"
        },
        "affected_paths": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Affected Paths",
          "type": "array"
        },
        "code": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Code",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Description",
          "type": "string"
        },
        "gap_id": {
          "$ref": "#/$defs/GapId"
        },
        "reason": {
          "enum": [
            "MISSING",
            "FAILED",
            "TRUNCATED",
            "UNSUPPORTED",
            "BLOCKED",
            "TIMEOUT"
          ],
          "title": "Reason",
          "type": "string"
        },
        "related_record_ids": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Related Record Ids",
          "type": "array"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "stage": {
          "enum": [
            "REPOSITORY",
            "STATIC_ANALYSIS",
            "CONTEXT",
            "DYNAMIC",
            "POLICY"
          ],
          "title": "Stage",
          "type": "string"
        }
      },
      "required": [
        "gap_id",
        "stage",
        "code",
        "reason",
        "description",
        "affected_paths",
        "affected_languages",
        "affected_locations",
        "retryable",
        "related_record_ids",
        "created_at"
      ],
      "title": "DataGap",
      "type": "object"
    },
    "ErrorId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "ErrorId",
      "type": "string"
    },
    "GapId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "GapId",
      "type": "string"
    },
    "HypothesisId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "HypothesisId",
      "type": "string"
    },
    "LogicalRecordId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "LogicalRecordId",
      "type": "string"
    },
    "RecordId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "RecordId",
      "type": "string"
    },
    "RecordMeta": {
      "additionalProperties": false,
      "properties": {
        "analysis_id": {
          "$ref": "#/$defs/AnalysisId"
        },
        "attempt_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/AttemptId"
            },
            {
              "type": "null"
            }
          ]
        },
        "commit_id": {
          "$ref": "#/$defs/CommitId"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "hypothesis_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/HypothesisId"
            },
            {
              "type": "null"
            }
          ]
        },
        "logical_record_id": {
          "$ref": "#/$defs/LogicalRecordId"
        },
        "previous_record_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecordId"
            },
            {
              "type": "null"
            }
          ]
        },
        "record_id": {
          "$ref": "#/$defs/RecordId"
        },
        "record_type": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Record Type",
          "type": "string"
        },
        "revision_number": {
          "minimum": 1,
          "title": "Revision Number",
          "type": "integer"
        },
        "schema_version": {
          "pattern": "^[1-9][0-9]*\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Schema Version",
          "type": "string"
        },
        "workspace_id": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "record_id",
        "logical_record_id",
        "record_type",
        "schema_version",
        "revision_number",
        "previous_record_id",
        "created_at",
        "analysis_id",
        "workspace_id",
        "commit_id",
        "hypothesis_id",
        "attempt_id"
      ],
      "title": "RecordMeta",
      "type": "object"
    },
    "StoredDataId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "StoredDataId",
      "type": "string"
    },
    "StoredDataRef": {
      "additionalProperties": false,
      "properties": {
        "commit_id": {
          "$ref": "#/$defs/CommitId"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "data_kind": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Data Kind",
          "type": "string"
        },
        "record_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecordId"
            },
            {
              "type": "null"
            }
          ]
        },
        "stored_data_id": {
          "$ref": "#/$defs/StoredDataId"
        },
        "workspace_id": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "stored_data_id",
        "data_kind",
        "content_hash",
        "workspace_id",
        "commit_id",
        "record_id"
      ],
      "title": "StoredDataRef",
      "type": "object"
    },
    "ToolSource": {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "$ref": "#/$defs/AttemptId"
        },
        "raw_result_ref": {
          "$ref": "#/$defs/StoredDataRef"
        },
        "rule_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rule Id"
        },
        "tool_name": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Tool Name",
          "type": "string"
        },
        "tool_version": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Tool Version",
          "type": "string"
        }
      },
      "required": [
        "attempt_id",
        "tool_name",
        "tool_version",
        "rule_id",
        "raw_result_ref"
      ],
      "title": "ToolSource",
      "type": "object"
    },
    "WorkId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "WorkId",
      "type": "string"
    },
    "WorkspaceId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "WorkspaceId",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "code_fragment_refs": {
      "items": {
        "$ref": "#/$defs/StoredDataRef"
      },
      "title": "Code Fragment Refs",
      "type": "array"
    },
    "code_request_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Code Request Id",
      "type": "string"
    },
    "consumed_token_estimate": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Consumed Token Estimate"
    },
    "discovered_relations": {
      "items": {
        "$ref": "#/$defs/CodeRelation"
      },
      "title": "Discovered Relations",
      "type": "array"
    },
    "entities": {
      "items": {
        "$ref": "#/$defs/CodeSymbol"
      },
      "title": "Entities",
      "type": "array"
    },
    "errors": {
      "items": {
        "$ref": "#/$defs/AnalysisError"
      },
      "title": "Errors",
      "type": "array"
    },
    "gaps": {
      "items": {
        "$ref": "#/$defs/DataGap"
      },
      "title": "Gaps",
      "type": "array"
    },
    "locations": {
      "items": {
        "$ref": "#/$defs/CodeLocation"
      },
      "title": "Locations",
      "type": "array"
    },
    "meta": {
      "$ref": "#/$defs/RecordMeta"
    },
    "returned_bytes": {
      "minimum": 0,
      "title": "Returned Bytes",
      "type": "integer"
    },
    "returned_fragment_count": {
      "minimum": 0,
      "title": "Returned Fragment Count",
      "type": "integer"
    },
    "truncated": {
      "title": "Truncated",
      "type": "boolean"
    }
  },
  "required": [
    "meta",
    "code_request_id",
    "entities",
    "locations",
    "code_fragment_refs",
    "discovered_relations",
    "gaps",
    "errors",
    "truncated",
    "returned_fragment_count",
    "returned_bytes",
    "consumed_token_estimate"
  ],
  "title": "CodeContextResponse",
  "type": "object"
}
