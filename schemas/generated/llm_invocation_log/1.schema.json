{
  "$defs": {
    "AnalysisId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "AnalysisId",
      "type": "string"
    },
    "AttemptId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "AttemptId",
      "type": "string"
    },
    "BudgetScopeRef": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunStoredDataRef"
        },
        {
          "$ref": "#/$defs/StoredDataRef"
        }
      ]
    },
    "CodeLocation": {
      "additionalProperties": false,
      "properties": {
        "commit_id": {
          "$ref": "#/$defs/CommitId"
        },
        "end_column": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "End Column"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "file_path": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "File Path",
          "type": "string"
        },
        "start_column": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Start Column"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        },
        "workspace_id": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "workspace_id",
        "commit_id",
        "file_path",
        "start_line",
        "start_column",
        "end_line",
        "end_column"
      ],
      "title": "CodeLocation",
      "type": "object"
    },
    "CommitId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "CommitId",
      "type": "string"
    },
    "HypothesisId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "HypothesisId",
      "type": "string"
    },
    "InvocationStatus": {
      "enum": [
        "SUCCEEDED",
        "FAILED",
        "INVALID_OUTPUT",
        "TIMED_OUT",
        "RATE_LIMITED",
        "AUTH_REQUIRED",
        "CANCELLED"
      ],
      "type": "string"
    },
    "JsonValue": {},
    "LLMRole": {
      "enum": [
        "HYPOTHESIS",
        "VERIFICATION",
        "PRO",
        "CON",
        "CWE_LABELING",
        "CHAINING",
        "TECHNICAL_GATE",
        "RULE_SCOPE_GATE",
        "REPORTER",
        "POLICY_PARSER",
        "DYNAMIC_REPRODUCTION"
      ],
      "type": "string"
    },
    "LogicalRecordId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "LogicalRecordId",
      "type": "string"
    },
    "Purpose": {
      "enum": [
        "EVALUATION",
        "PRODUCTION"
      ],
      "type": "string"
    },
    "RecordId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "RecordId",
      "type": "string"
    },
    "RecordMeta": {
      "additionalProperties": false,
      "properties": {
        "analysis_id": {
          "$ref": "#/$defs/AnalysisId"
        },
        "attempt_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/AttemptId"
            },
            {
              "type": "null"
            }
          ]
        },
        "commit_id": {
          "$ref": "#/$defs/CommitId"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "hypothesis_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/HypothesisId"
            },
            {
              "type": "null"
            }
          ]
        },
        "logical_record_id": {
          "$ref": "#/$defs/LogicalRecordId"
        },
        "previous_record_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecordId"
            },
            {
              "type": "null"
            }
          ]
        },
        "record_id": {
          "$ref": "#/$defs/RecordId"
        },
        "record_type": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Record Type",
          "type": "string"
        },
        "revision_number": {
          "minimum": 1,
          "title": "Revision Number",
          "type": "integer"
        },
        "schema_version": {
          "pattern": "^[1-9][0-9]*\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Schema Version",
          "type": "string"
        },
        "workspace_id": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "record_id",
        "logical_record_id",
        "record_type",
        "schema_version",
        "revision_number",
        "previous_record_id",
        "created_at",
        "analysis_id",
        "workspace_id",
        "commit_id",
        "hypothesis_id",
        "attempt_id"
      ],
      "title": "RecordMeta",
      "type": "object"
    },
    "RunStoredDataRef": {
      "additionalProperties": false,
      "properties": {
        "analysis_id": {
          "$ref": "#/$defs/AnalysisId"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "data_kind": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Data Kind",
          "type": "string"
        },
        "record_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecordId"
            },
            {
              "type": "null"
            }
          ]
        },
        "stored_data_id": {
          "$ref": "#/$defs/StoredDataId"
        }
      },
      "required": [
        "stored_data_id",
        "data_kind",
        "content_hash",
        "analysis_id",
        "record_id"
      ],
      "title": "RunStoredDataRef",
      "type": "object"
    },
    "SessionPolicy": {
      "enum": [
        "NEW",
        "RESUME",
        "AUTO"
      ],
      "type": "string"
    },
    "StoredDataId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "StoredDataId",
      "type": "string"
    },
    "StoredDataRef": {
      "additionalProperties": false,
      "properties": {
        "commit_id": {
          "$ref": "#/$defs/CommitId"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "data_kind": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Data Kind",
          "type": "string"
        },
        "record_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecordId"
            },
            {
              "type": "null"
            }
          ]
        },
        "stored_data_id": {
          "$ref": "#/$defs/StoredDataId"
        },
        "workspace_id": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "stored_data_id",
        "data_kind",
        "content_hash",
        "workspace_id",
        "commit_id",
        "record_id"
      ],
      "title": "StoredDataRef",
      "type": "object"
    },
    "UsageMeasurement": {
      "additionalProperties": false,
      "properties": {
        "cost_minor_units": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cost Minor Units"
        },
        "cost_source": {
          "enum": [
            "PROVIDER_REPORTED",
            "PRICING_REVISION_CALCULATED",
            "RESERVED_MAXIMUM",
            "UNAVAILABLE"
          ],
          "title": "Cost Source",
          "type": "string"
        },
        "cost_unavailable_reason": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cost Unavailable Reason"
        },
        "currency": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Currency"
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Output Tokens"
        },
        "pricing_revision_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/BudgetScopeRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "provider_units": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Provider Units",
          "type": "object"
        },
        "token_source": {
          "enum": [
            "PROVIDER_REPORTED",
            "ADAPTER_REPORTED",
            "UNAVAILABLE"
          ],
          "title": "Token Source",
          "type": "string"
        },
        "token_unavailable_reason": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Token Unavailable Reason"
        },
        "total_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Total Tokens"
        }
      },
      "required": [
        "token_source",
        "input_tokens",
        "output_tokens",
        "total_tokens",
        "token_unavailable_reason",
        "provider_units",
        "cost_source",
        "cost_minor_units",
        "currency",
        "pricing_revision_ref",
        "cost_unavailable_reason"
      ],
      "title": "UsageMeasurement",
      "type": "object"
    },
    "WorkspaceId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "WorkspaceId",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action_decision_ref": {
      "$ref": "#/$defs/StoredDataRef"
    },
    "agent_role": {
      "$ref": "#/$defs/LLMRole"
    },
    "call_spec_ref": {
      "$ref": "#/$defs/StoredDataRef"
    },
    "context_refs": {
      "items": {
        "$ref": "#/$defs/StoredDataRef"
      },
      "title": "Context Refs",
      "type": "array"
    },
    "elapsed_ms": {
      "minimum": 0,
      "title": "Elapsed Ms",
      "type": "integer"
    },
    "execution_limits_ref": {
      "$ref": "#/$defs/StoredDataRef"
    },
    "exposed_request_ref": {
      "$ref": "#/$defs/StoredDataRef"
    },
    "exposed_response_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/StoredDataRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "failover_from_llm_call_id": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Failover From Llm Call Id"
    },
    "finished_at": {
      "format": "date-time",
      "title": "Finished At",
      "type": "string"
    },
    "llm_call_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Llm Call Id",
      "type": "string"
    },
    "meta": {
      "$ref": "#/$defs/RecordMeta"
    },
    "model": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Model",
      "type": "string"
    },
    "output_schema_ref": {
      "$ref": "#/$defs/StoredDataRef"
    },
    "parent_session_ref": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Parent Session Ref"
    },
    "parsed_output_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/StoredDataRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "prompt_key": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Prompt Key",
      "type": "string"
    },
    "prompt_payload_ref": {
      "$ref": "#/$defs/StoredDataRef"
    },
    "prompt_registry_entry_ref": {
      "$ref": "#/$defs/StoredDataRef"
    },
    "prompt_template_ref": {
      "$ref": "#/$defs/StoredDataRef"
    },
    "prompt_template_version": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Prompt Template Version",
      "type": "string"
    },
    "provider": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Provider",
      "type": "string"
    },
    "provider_profile_ref": {
      "$ref": "#/$defs/StoredDataRef"
    },
    "purpose": {
      "$ref": "#/$defs/Purpose"
    },
    "redaction_policy_ref": {
      "$ref": "#/$defs/StoredDataRef"
    },
    "redaction_result": {
      "enum": [
        "APPLIED",
        "NOT_REQUIRED",
        "FAILED"
      ],
      "title": "Redaction Result",
      "type": "string"
    },
    "repair_attempts": {
      "minimum": 0,
      "title": "Repair Attempts",
      "type": "integer"
    },
    "retrieved_code_locations": {
      "items": {
        "$ref": "#/$defs/CodeLocation"
      },
      "title": "Retrieved Code Locations",
      "type": "array"
    },
    "retry_count": {
      "minimum": 0,
      "title": "Retry Count",
      "type": "integer"
    },
    "retry_of_llm_call_id": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Retry Of Llm Call Id"
    },
    "retry_policy_ref": {
      "$ref": "#/$defs/StoredDataRef"
    },
    "safe_error": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Safe Error"
    },
    "semantic_validator_ref": {
      "$ref": "#/$defs/StoredDataRef"
    },
    "session_policy": {
      "$ref": "#/$defs/SessionPolicy"
    },
    "session_ref": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Session Ref"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/InvocationStatus"
    },
    "task_kind": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Task Kind",
      "type": "string"
    },
    "tool_calls": {
      "items": {
        "$ref": "#/$defs/StoredDataRef"
      },
      "title": "Tool Calls",
      "type": "array"
    },
    "tool_policy_ref": {
      "$ref": "#/$defs/StoredDataRef"
    },
    "usage": {
      "anyOf": [
        {
          "$ref": "#/$defs/UsageMeasurement"
        },
        {
          "type": "null"
        }
      ]
    },
    "validation_errors": {
      "items": {
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "title": "Validation Errors",
      "type": "array"
    }
  },
  "required": [
    "meta",
    "llm_call_id",
    "action_decision_ref",
    "call_spec_ref",
    "agent_role",
    "task_kind",
    "purpose",
    "provider_profile_ref",
    "provider",
    "model",
    "session_policy",
    "session_ref",
    "parent_session_ref",
    "prompt_registry_entry_ref",
    "prompt_key",
    "prompt_template_ref",
    "prompt_template_version",
    "prompt_payload_ref",
    "execution_limits_ref",
    "retry_policy_ref",
    "tool_policy_ref",
    "redaction_policy_ref",
    "semantic_validator_ref",
    "output_schema_ref",
    "context_refs",
    "retrieved_code_locations",
    "exposed_request_ref",
    "exposed_response_ref",
    "parsed_output_ref",
    "tool_calls",
    "usage",
    "started_at",
    "finished_at",
    "elapsed_ms",
    "retry_count",
    "status",
    "safe_error",
    "validation_errors",
    "repair_attempts",
    "retry_of_llm_call_id",
    "failover_from_llm_call_id",
    "redaction_result"
  ],
  "title": "LLMInvocationLog",
  "type": "object"
}
