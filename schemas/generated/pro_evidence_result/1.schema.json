{
  "$defs": {
    "AnalysisId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "AnalysisId",
      "type": "string"
    },
    "AttemptId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "AttemptId",
      "type": "string"
    },
    "CodeLocation": {
      "additionalProperties": false,
      "properties": {
        "commit_id": {
          "$ref": "#/$defs/CommitId"
        },
        "end_column": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "End Column"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "file_path": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "File Path",
          "type": "string"
        },
        "start_column": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Start Column"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        },
        "workspace_id": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "workspace_id",
        "commit_id",
        "file_path",
        "start_line",
        "start_column",
        "end_line",
        "end_column"
      ],
      "title": "CodeLocation",
      "type": "object"
    },
    "CommitId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "CommitId",
      "type": "string"
    },
    "EvidenceClaim": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Claim Id",
          "type": "string"
        },
        "code_locations": {
          "items": {
            "$ref": "#/$defs/CodeLocation"
          },
          "title": "Code Locations",
          "type": "array"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/StoredDataRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "limitations": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "source_role": {
          "enum": [
            "VERIFICATION",
            "PRO",
            "CON"
          ],
          "title": "Source Role",
          "type": "string"
        },
        "statement": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "statement",
        "source_role",
        "evidence_refs",
        "code_locations",
        "limitations"
      ],
      "title": "EvidenceClaim",
      "type": "object"
    },
    "HypothesisId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "HypothesisId",
      "type": "string"
    },
    "LogicalRecordId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "LogicalRecordId",
      "type": "string"
    },
    "RecordId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "RecordId",
      "type": "string"
    },
    "RecordMeta": {
      "additionalProperties": false,
      "properties": {
        "analysis_id": {
          "$ref": "#/$defs/AnalysisId"
        },
        "attempt_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/AttemptId"
            },
            {
              "type": "null"
            }
          ]
        },
        "commit_id": {
          "$ref": "#/$defs/CommitId"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "hypothesis_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/HypothesisId"
            },
            {
              "type": "null"
            }
          ]
        },
        "logical_record_id": {
          "$ref": "#/$defs/LogicalRecordId"
        },
        "previous_record_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecordId"
            },
            {
              "type": "null"
            }
          ]
        },
        "record_id": {
          "$ref": "#/$defs/RecordId"
        },
        "record_type": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Record Type",
          "type": "string"
        },
        "revision_number": {
          "minimum": 1,
          "title": "Revision Number",
          "type": "integer"
        },
        "schema_version": {
          "pattern": "^[1-9][0-9]*\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Schema Version",
          "type": "string"
        },
        "workspace_id": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "record_id",
        "logical_record_id",
        "record_type",
        "schema_version",
        "revision_number",
        "previous_record_id",
        "created_at",
        "analysis_id",
        "workspace_id",
        "commit_id",
        "hypothesis_id",
        "attempt_id"
      ],
      "title": "RecordMeta",
      "type": "object"
    },
    "StoredDataId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "StoredDataId",
      "type": "string"
    },
    "StoredDataRef": {
      "additionalProperties": false,
      "properties": {
        "commit_id": {
          "$ref": "#/$defs/CommitId"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "data_kind": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Data Kind",
          "type": "string"
        },
        "record_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecordId"
            },
            {
              "type": "null"
            }
          ]
        },
        "stored_data_id": {
          "$ref": "#/$defs/StoredDataId"
        },
        "workspace_id": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "stored_data_id",
        "data_kind",
        "content_hash",
        "workspace_id",
        "commit_id",
        "record_id"
      ],
      "title": "StoredDataRef",
      "type": "object"
    },
    "WorkId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "WorkId",
      "type": "string"
    },
    "WorkspaceId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "WorkspaceId",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "debate_input_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Debate Input Hash",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceClaim"
      },
      "title": "Evidence",
      "type": "array"
    },
    "evidence_work_id": {
      "$ref": "#/$defs/WorkId"
    },
    "limitations": {
      "items": {
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "llm_call_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Llm Call Id",
      "type": "string"
    },
    "meta": {
      "$ref": "#/$defs/RecordMeta"
    },
    "parent_work_id": {
      "$ref": "#/$defs/WorkId"
    },
    "role": {
      "const": "PRO",
      "title": "Role",
      "type": "string"
    },
    "summary": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Summary",
      "type": "string"
    },
    "verification_generation": {
      "minimum": 1,
      "title": "Verification Generation",
      "type": "integer"
    }
  },
  "required": [
    "meta",
    "role",
    "parent_work_id",
    "evidence_work_id",
    "verification_generation",
    "llm_call_id",
    "debate_input_hash",
    "evidence",
    "summary",
    "limitations"
  ],
  "title": "ProEvidenceResult",
  "type": "object"
}
