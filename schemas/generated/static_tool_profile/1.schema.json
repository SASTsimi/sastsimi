{
  "$defs": {
    "AnalysisId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "AnalysisId",
      "type": "string"
    },
    "AttemptId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "AttemptId",
      "type": "string"
    },
    "CommitId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "CommitId",
      "type": "string"
    },
    "HypothesisId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "HypothesisId",
      "type": "string"
    },
    "LogicalRecordId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "LogicalRecordId",
      "type": "string"
    },
    "RecordId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "RecordId",
      "type": "string"
    },
    "RecordMeta": {
      "additionalProperties": false,
      "properties": {
        "analysis_id": {
          "$ref": "#/$defs/AnalysisId"
        },
        "attempt_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/AttemptId"
            },
            {
              "type": "null"
            }
          ]
        },
        "commit_id": {
          "$ref": "#/$defs/CommitId"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "hypothesis_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/HypothesisId"
            },
            {
              "type": "null"
            }
          ]
        },
        "logical_record_id": {
          "$ref": "#/$defs/LogicalRecordId"
        },
        "previous_record_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecordId"
            },
            {
              "type": "null"
            }
          ]
        },
        "record_id": {
          "$ref": "#/$defs/RecordId"
        },
        "record_type": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Record Type",
          "type": "string"
        },
        "revision_number": {
          "minimum": 1,
          "title": "Revision Number",
          "type": "integer"
        },
        "schema_version": {
          "pattern": "^[1-9][0-9]*\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Schema Version",
          "type": "string"
        },
        "workspace_id": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "record_id",
        "logical_record_id",
        "record_type",
        "schema_version",
        "revision_number",
        "previous_record_id",
        "created_at",
        "analysis_id",
        "workspace_id",
        "commit_id",
        "hypothesis_id",
        "attempt_id"
      ],
      "title": "RecordMeta",
      "type": "object"
    },
    "StoredDataId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "StoredDataId",
      "type": "string"
    },
    "StoredDataRef": {
      "additionalProperties": false,
      "properties": {
        "commit_id": {
          "$ref": "#/$defs/CommitId"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "data_kind": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Data Kind",
          "type": "string"
        },
        "record_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecordId"
            },
            {
              "type": "null"
            }
          ]
        },
        "stored_data_id": {
          "$ref": "#/$defs/StoredDataId"
        },
        "workspace_id": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "stored_data_id",
        "data_kind",
        "content_hash",
        "workspace_id",
        "commit_id",
        "record_id"
      ],
      "title": "StoredDataRef",
      "type": "object"
    },
    "WorkspaceId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "WorkspaceId",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Exact immutable configuration for one static-tool adapter revision.",
  "properties": {
    "adapter_key": {
      "enum": [
        "PYTHON_AST",
        "CODEQL",
        "OPENGREP"
      ],
      "title": "Adapter Key",
      "type": "string"
    },
    "capability_evidence_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/StoredDataRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "executable_key": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Executable Key",
      "type": "string"
    },
    "executable_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Executable Sha256",
      "type": "string"
    },
    "expected_version": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Expected Version",
      "type": "string"
    },
    "max_artifact_read_bytes": {
      "minimum": 1,
      "title": "Max Artifact Read Bytes",
      "type": "integer"
    },
    "max_attempt_output_bytes": {
      "minimum": 1,
      "title": "Max Attempt Output Bytes",
      "type": "integer"
    },
    "max_output_file_bytes": {
      "minimum": 1,
      "title": "Max Output File Bytes",
      "type": "integer"
    },
    "meta": {
      "$ref": "#/$defs/RecordMeta"
    },
    "probe_timeout_ms": {
      "minimum": 1,
      "title": "Probe Timeout Ms",
      "type": "integer"
    },
    "profile_key": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Profile Key",
      "type": "string"
    },
    "purpose": {
      "enum": [
        "FIXTURE",
        "EVALUATION",
        "PRODUCTION"
      ],
      "title": "Purpose",
      "type": "string"
    },
    "run_timeout_ms": {
      "minimum": 1,
      "title": "Run Timeout Ms",
      "type": "integer"
    },
    "status": {
      "enum": [
        "DRAFT",
        "APPROVED",
        "ACTIVE",
        "RETIRED"
      ],
      "title": "Status",
      "type": "string"
    },
    "stderr_limit_bytes": {
      "minimum": 1,
      "title": "Stderr Limit Bytes",
      "type": "integer"
    },
    "stdout_limit_bytes": {
      "minimum": 1,
      "title": "Stdout Limit Bytes",
      "type": "integer"
    },
    "tool_kind": {
      "enum": [
        "STRUCTURE",
        "RULE_BASED"
      ],
      "title": "Tool Kind",
      "type": "string"
    },
    "tool_name": {
      "enum": [
        "AST",
        "CODEQL",
        "OPENGREP"
      ],
      "title": "Tool Name",
      "type": "string"
    }
  },
  "required": [
    "meta",
    "profile_key",
    "purpose",
    "status",
    "adapter_key",
    "tool_name",
    "tool_kind",
    "executable_key",
    "executable_sha256",
    "expected_version",
    "capability_evidence_ref",
    "probe_timeout_ms",
    "run_timeout_ms",
    "stdout_limit_bytes",
    "stderr_limit_bytes",
    "max_attempt_output_bytes",
    "max_output_file_bytes",
    "max_artifact_read_bytes"
  ],
  "title": "StaticToolProfile",
  "type": "object"
}
