{
  "$defs": {
    "AnalysisId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "AnalysisId",
      "type": "string"
    },
    "AttemptId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "AttemptId",
      "type": "string"
    },
    "CodeQLBoundaryCapability": {
      "additionalProperties": false,
      "description": "Exact prebuilt-database and hard-quota boundary approved for CodeQL.",
      "properties": {
        "container_user": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Container User",
          "type": "string"
        },
        "database_limit_bytes": {
          "minimum": 1,
          "title": "Database Limit Bytes",
          "type": "integer"
        },
        "database_provider_evidence_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Database Provider Evidence Sha256",
          "type": "string"
        },
        "database_provider_key": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Database Provider Key",
          "type": "string"
        },
        "database_provider_revision": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Database Provider Revision",
          "type": "string"
        },
        "execution_limit_bytes": {
          "minimum": 1,
          "title": "Execution Limit Bytes",
          "type": "integer"
        },
        "expected_codeql_version": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Expected Codeql Version",
          "type": "string"
        },
        "image_digest": {
          "title": "Image Digest",
          "type": "string"
        },
        "memory_limit_bytes": {
          "minimum": 1,
          "title": "Memory Limit Bytes",
          "type": "integer"
        },
        "nano_cpus": {
          "minimum": 1,
          "title": "Nano Cpus",
          "type": "integer"
        },
        "pids_limit": {
          "minimum": 1,
          "title": "Pids Limit",
          "type": "integer"
        },
        "prebuilt_database_only": {
          "const": true,
          "title": "Prebuilt Database Only",
          "type": "boolean"
        },
        "query_pack_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Query Pack Sha256",
          "type": "string"
        },
        "quota_backend_key": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Quota Backend Key",
          "type": "string"
        },
        "quota_enforcement_identity_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Quota Enforcement Identity Sha256",
          "type": "string"
        },
        "supported_languages": {
          "items": {
            "enum": [
              "PYTHON",
              "JAVASCRIPT"
            ],
            "type": "string"
          },
          "title": "Supported Languages",
          "type": "array"
        }
      },
      "required": [
        "quota_backend_key",
        "quota_enforcement_identity_sha256",
        "database_limit_bytes",
        "execution_limit_bytes",
        "database_provider_key",
        "database_provider_revision",
        "database_provider_evidence_sha256",
        "image_digest",
        "expected_codeql_version",
        "query_pack_sha256",
        "container_user",
        "pids_limit",
        "memory_limit_bytes",
        "nano_cpus",
        "supported_languages",
        "prebuilt_database_only"
      ],
      "title": "CodeQLBoundaryCapability",
      "type": "object"
    },
    "CommitId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "CommitId",
      "type": "string"
    },
    "HostConfigurationRef": {
      "additionalProperties": false,
      "description": "Exact host configuration revision reusable across repository analyses.",
      "properties": {
        "configuration_scope": {
          "const": "HOST",
          "default": "HOST",
          "title": "Configuration Scope",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "data_kind": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Data Kind",
          "type": "string"
        },
        "host_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Host Id",
          "type": "string"
        },
        "publication_analysis_id": {
          "$ref": "#/$defs/AnalysisId"
        },
        "publication_commit_id": {
          "$ref": "#/$defs/CommitId"
        },
        "publication_workspace_id": {
          "$ref": "#/$defs/WorkspaceId"
        },
        "record_id": {
          "$ref": "#/$defs/RecordId"
        },
        "stored_data_id": {
          "$ref": "#/$defs/StoredDataId"
        }
      },
      "required": [
        "stored_data_id",
        "data_kind",
        "content_hash",
        "host_id",
        "publication_analysis_id",
        "publication_workspace_id",
        "publication_commit_id",
        "record_id"
      ],
      "title": "HostConfigurationRef",
      "type": "object"
    },
    "HypothesisId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "HypothesisId",
      "type": "string"
    },
    "LogicalRecordId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "LogicalRecordId",
      "type": "string"
    },
    "RecordId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "RecordId",
      "type": "string"
    },
    "RecordMeta": {
      "additionalProperties": false,
      "properties": {
        "analysis_id": {
          "$ref": "#/$defs/AnalysisId"
        },
        "attempt_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/AttemptId"
            },
            {
              "type": "null"
            }
          ]
        },
        "commit_id": {
          "$ref": "#/$defs/CommitId"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "hypothesis_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/HypothesisId"
            },
            {
              "type": "null"
            }
          ]
        },
        "logical_record_id": {
          "$ref": "#/$defs/LogicalRecordId"
        },
        "previous_record_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecordId"
            },
            {
              "type": "null"
            }
          ]
        },
        "record_id": {
          "$ref": "#/$defs/RecordId"
        },
        "record_type": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Record Type",
          "type": "string"
        },
        "revision_number": {
          "minimum": 1,
          "title": "Revision Number",
          "type": "integer"
        },
        "schema_version": {
          "pattern": "^[1-9][0-9]*\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Schema Version",
          "type": "string"
        },
        "workspace_id": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "record_id",
        "logical_record_id",
        "record_type",
        "schema_version",
        "revision_number",
        "previous_record_id",
        "created_at",
        "analysis_id",
        "workspace_id",
        "commit_id",
        "hypothesis_id",
        "attempt_id"
      ],
      "title": "RecordMeta",
      "type": "object"
    },
    "StoredDataId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "StoredDataId",
      "type": "string"
    },
    "WorkspaceId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "WorkspaceId",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Exact immutable configuration for one static-tool adapter revision.",
  "properties": {
    "adapter_key": {
      "enum": [
        "PYTHON_AST",
        "CODEQL",
        "OPENGREP"
      ],
      "title": "Adapter Key",
      "type": "string"
    },
    "capability_evidence_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/HostConfigurationRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "codeql_boundary": {
      "anyOf": [
        {
          "$ref": "#/$defs/CodeQLBoundaryCapability"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "executable_key": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Executable Key",
      "type": "string"
    },
    "executable_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Executable Sha256",
      "type": "string"
    },
    "expected_version": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Expected Version",
      "type": "string"
    },
    "host_id": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Host Id"
    },
    "max_artifact_read_bytes": {
      "minimum": 1,
      "title": "Max Artifact Read Bytes",
      "type": "integer"
    },
    "max_attempt_output_bytes": {
      "minimum": 1,
      "title": "Max Attempt Output Bytes",
      "type": "integer"
    },
    "max_output_file_bytes": {
      "minimum": 1,
      "title": "Max Output File Bytes",
      "type": "integer"
    },
    "meta": {
      "$ref": "#/$defs/RecordMeta"
    },
    "probe_timeout_ms": {
      "minimum": 1,
      "title": "Probe Timeout Ms",
      "type": "integer"
    },
    "profile_key": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Profile Key",
      "type": "string"
    },
    "purpose": {
      "enum": [
        "FIXTURE",
        "EVALUATION",
        "PRODUCTION",
        "LOCAL_EVALUATION"
      ],
      "title": "Purpose",
      "type": "string"
    },
    "run_timeout_ms": {
      "minimum": 1,
      "title": "Run Timeout Ms",
      "type": "integer"
    },
    "status": {
      "enum": [
        "DRAFT",
        "APPROVED",
        "ACTIVE",
        "RETIRED"
      ],
      "title": "Status",
      "type": "string"
    },
    "stderr_limit_bytes": {
      "minimum": 1,
      "title": "Stderr Limit Bytes",
      "type": "integer"
    },
    "stdout_limit_bytes": {
      "minimum": 1,
      "title": "Stdout Limit Bytes",
      "type": "integer"
    },
    "tool_kind": {
      "enum": [
        "STRUCTURE",
        "RULE_BASED"
      ],
      "title": "Tool Kind",
      "type": "string"
    },
    "tool_name": {
      "enum": [
        "AST",
        "CODEQL",
        "OPENGREP"
      ],
      "title": "Tool Name",
      "type": "string"
    }
  },
  "required": [
    "meta",
    "profile_key",
    "purpose",
    "status",
    "adapter_key",
    "tool_name",
    "tool_kind",
    "executable_key",
    "executable_sha256",
    "expected_version",
    "capability_evidence_ref",
    "probe_timeout_ms",
    "run_timeout_ms",
    "stdout_limit_bytes",
    "stderr_limit_bytes",
    "max_attempt_output_bytes",
    "max_output_file_bytes",
    "max_artifact_read_bytes"
  ],
  "title": "StaticToolProfile",
  "type": "object"
}
