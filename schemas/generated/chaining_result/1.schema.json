{
  "$defs": {
    "AnalysisError": {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/AttemptId"
            },
            {
              "type": "null"
            }
          ]
        },
        "code": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Code",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "error_id": {
          "$ref": "#/$defs/ErrorId"
        },
        "related_record_ids": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Related Record Ids",
          "type": "array"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "safe_message": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Safe Message",
          "type": "string"
        },
        "stage": {
          "enum": [
            "INPUT",
            "REPOSITORY",
            "STATIC_ANALYSIS",
            "CONTEXT",
            "ORCHESTRATION",
            "AGENT",
            "PROVIDER",
            "SANDBOX",
            "POLICY",
            "GATE",
            "REPORT",
            "STATE",
            "STORAGE",
            "RECOVERY",
            "AUTHORITY"
          ],
          "title": "Stage",
          "type": "string"
        },
        "work_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "error_id",
        "stage",
        "code",
        "safe_message",
        "retryable",
        "work_id",
        "attempt_id",
        "related_record_ids",
        "created_at"
      ],
      "title": "AnalysisError",
      "type": "object"
    },
    "AnalysisId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "AnalysisId",
      "type": "string"
    },
    "AttemptId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "AttemptId",
      "type": "string"
    },
    "CodeFact": {
      "additionalProperties": false,
      "properties": {
        "fact_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Fact Id",
          "type": "string"
        },
        "fact_kind": {
          "enum": [
            "SOURCE",
            "SINK",
            "SANITIZER",
            "VALIDATOR",
            "AUTH_CHECK",
            "PERMISSION_CHECK",
            "OTHER"
          ],
          "title": "Fact Kind",
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/CodeLocation"
        },
        "producer": {
          "$ref": "#/$defs/ToolSource"
        },
        "symbol_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Symbol Id"
        }
      },
      "required": [
        "fact_id",
        "fact_kind",
        "symbol_id",
        "location",
        "producer"
      ],
      "title": "CodeFact",
      "type": "object"
    },
    "CodeFactRef": {
      "additionalProperties": false,
      "properties": {
        "bundle_ref": {
          "$ref": "#/$defs/StoredDataRef"
        },
        "fact_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Fact Id",
          "type": "string"
        }
      },
      "required": [
        "bundle_ref",
        "fact_id"
      ],
      "title": "CodeFactRef",
      "type": "object"
    },
    "CodeLocation": {
      "additionalProperties": false,
      "properties": {
        "commit_id": {
          "$ref": "#/$defs/CommitId"
        },
        "end_column": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "End Column"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "file_path": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "File Path",
          "type": "string"
        },
        "start_column": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Start Column"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        },
        "workspace_id": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "workspace_id",
        "commit_id",
        "file_path",
        "start_line",
        "start_column",
        "end_line",
        "end_column"
      ],
      "title": "CodeLocation",
      "type": "object"
    },
    "CodeRelation": {
      "additionalProperties": false,
      "properties": {
        "from_location": {
          "$ref": "#/$defs/CodeLocation"
        },
        "from_symbol_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "From Symbol Id"
        },
        "producer": {
          "$ref": "#/$defs/ToolSource"
        },
        "relation_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Relation Id",
          "type": "string"
        },
        "relation_kind": {
          "enum": [
            "CALL",
            "DATA_FLOW",
            "IMPORT",
            "INHERITANCE",
            "ROUTE_BINDING",
            "OTHER"
          ],
          "title": "Relation Kind",
          "type": "string"
        },
        "to_location": {
          "$ref": "#/$defs/CodeLocation"
        },
        "to_symbol_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "To Symbol Id"
        }
      },
      "required": [
        "relation_id",
        "relation_kind",
        "from_symbol_id",
        "from_location",
        "to_symbol_id",
        "to_location",
        "producer"
      ],
      "title": "CodeRelation",
      "type": "object"
    },
    "CodeSymbol": {
      "additionalProperties": false,
      "properties": {
        "location": {
          "$ref": "#/$defs/CodeLocation"
        },
        "name": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Name",
          "type": "string"
        },
        "native_kind": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Native Kind"
        },
        "symbol_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Symbol Id",
          "type": "string"
        },
        "symbol_kind": {
          "enum": [
            "FILE",
            "MODULE",
            "TYPE",
            "CALLABLE",
            "DATA",
            "ROUTE",
            "CONFIG"
          ],
          "title": "Symbol Kind",
          "type": "string"
        }
      },
      "required": [
        "symbol_id",
        "symbol_kind",
        "native_kind",
        "name",
        "location"
      ],
      "title": "CodeSymbol",
      "type": "object"
    },
    "CommitId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "CommitId",
      "type": "string"
    },
    "ErrorId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "ErrorId",
      "type": "string"
    },
    "FalsificationQuestion": {
      "additionalProperties": false,
      "properties": {
        "question": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Question",
          "type": "string"
        },
        "question_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Question Id",
          "type": "string"
        }
      },
      "required": [
        "question_id",
        "question"
      ],
      "title": "FalsificationQuestion",
      "type": "object"
    },
    "HypothesisId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "HypothesisId",
      "type": "string"
    },
    "HypothesisProposal": {
      "additionalProperties": false,
      "properties": {
        "assertion_mode": {
          "const": "NON_FINAL",
          "title": "Assertion Mode",
          "type": "string"
        },
        "assumptions": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "falsification_questions": {
          "items": {
            "$ref": "#/$defs/FalsificationQuestion"
          },
          "title": "Falsification Questions",
          "type": "array"
        },
        "meta": {
          "$ref": "#/$defs/RecordMeta"
        },
        "observed_facts": {
          "items": {
            "$ref": "#/$defs/CodeFact"
          },
          "title": "Observed Facts",
          "type": "array"
        },
        "origin": {
          "enum": [
            "INITIAL",
            "VERIFICATION",
            "CHAINING"
          ],
          "title": "Origin",
          "type": "string"
        },
        "parent_hypothesis_ids": {
          "items": {
            "$ref": "#/$defs/HypothesisId"
          },
          "title": "Parent Hypothesis Ids",
          "type": "array"
        },
        "proposal_id": {
          "$ref": "#/$defs/ProposalId"
        },
        "proposal_state": {
          "const": "HYPOTHESIS_ONLY",
          "title": "Proposal State",
          "type": "string"
        },
        "restrictions": {
          "items": {
            "$ref": "#/$defs/Restriction"
          },
          "title": "Restrictions",
          "type": "array"
        },
        "source_primitive_match_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Primitive Match Id"
        },
        "suspected_path": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/CodeRelation"
              },
              {
                "$ref": "#/$defs/CodeLocation"
              }
            ]
          },
          "title": "Suspected Path",
          "type": "array"
        },
        "target_entities": {
          "items": {
            "$ref": "#/$defs/CodeSymbol"
          },
          "title": "Target Entities",
          "type": "array"
        },
        "target_locations": {
          "items": {
            "$ref": "#/$defs/CodeLocation"
          },
          "title": "Target Locations",
          "type": "array"
        },
        "validation_checks": {
          "items": {
            "$ref": "#/$defs/ValidationCheck"
          },
          "title": "Validation Checks",
          "type": "array"
        },
        "vulnerability_type_candidates": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Vulnerability Type Candidates",
          "type": "array"
        }
      },
      "required": [
        "meta",
        "origin",
        "target_entities",
        "target_locations",
        "suspected_path",
        "falsification_questions",
        "validation_checks",
        "parent_hypothesis_ids",
        "source_primitive_match_id",
        "proposal_id",
        "proposal_state",
        "assertion_mode",
        "vulnerability_type_candidates",
        "observed_facts",
        "assumptions",
        "restrictions"
      ],
      "title": "HypothesisProposal",
      "type": "object"
    },
    "LineageExclusion": {
      "additionalProperties": false,
      "properties": {
        "excluded_by_ref": {
          "$ref": "#/$defs/StoredDataRef"
        },
        "excluded_primitive_ref": {
          "$ref": "#/$defs/StoredDataRef"
        },
        "reason_code": {
          "const": "ANCESTOR_REUSE",
          "title": "Reason Code",
          "type": "string"
        }
      },
      "required": [
        "excluded_primitive_ref",
        "excluded_by_ref",
        "reason_code"
      ],
      "title": "LineageExclusion",
      "type": "object"
    },
    "LogicalRecordId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "LogicalRecordId",
      "type": "string"
    },
    "NoMatchReason": {
      "additionalProperties": false,
      "properties": {
        "checked_input_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Checked Input Id",
          "type": "string"
        },
        "detail": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Detail",
          "type": "string"
        },
        "downstream_input_ref": {
          "$ref": "#/$defs/StoredDataRef"
        },
        "reason_code": {
          "enum": [
            "ENTITY_UNRELATED",
            "PRIVILEGE_UNSATISFIED",
            "ORDER_INVALID",
            "RESTRICTION_CONFLICT",
            "NO_CODE_EVIDENCE"
          ],
          "title": "Reason Code",
          "type": "string"
        },
        "upstream_result_ref": {
          "$ref": "#/$defs/StoredDataRef"
        }
      },
      "required": [
        "upstream_result_ref",
        "downstream_input_ref",
        "checked_input_id",
        "reason_code",
        "detail"
      ],
      "title": "NoMatchReason",
      "type": "object"
    },
    "PrimitiveMatchCandidate": {
      "additionalProperties": false,
      "properties": {
        "candidate_state": {
          "const": "UNVALIDATED",
          "title": "Candidate State",
          "type": "string"
        },
        "commit_id": {
          "$ref": "#/$defs/CommitId"
        },
        "downstream_input_ref": {
          "$ref": "#/$defs/StoredDataRef"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/StoredDataRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "matched_input_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Matched Input Id",
          "type": "string"
        },
        "parent_hypothesis_ids": {
          "items": {
            "$ref": "#/$defs/HypothesisId"
          },
          "title": "Parent Hypothesis Ids",
          "type": "array"
        },
        "parent_verification_refs": {
          "items": {
            "$ref": "#/$defs/StoredDataRef"
          },
          "title": "Parent Verification Refs",
          "type": "array"
        },
        "primitive_match_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Primitive Match Id",
          "type": "string"
        },
        "upstream_result_ref": {
          "$ref": "#/$defs/StoredDataRef"
        },
        "workspace_id": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "primitive_match_id",
        "upstream_result_ref",
        "downstream_input_ref",
        "matched_input_id",
        "parent_hypothesis_ids",
        "parent_verification_refs",
        "workspace_id",
        "commit_id",
        "evidence_refs",
        "candidate_state"
      ],
      "title": "PrimitiveMatchCandidate",
      "type": "object"
    },
    "ProposalId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "ProposalId",
      "type": "string"
    },
    "RecordId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "RecordId",
      "type": "string"
    },
    "RecordMeta": {
      "additionalProperties": false,
      "properties": {
        "analysis_id": {
          "$ref": "#/$defs/AnalysisId"
        },
        "attempt_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/AttemptId"
            },
            {
              "type": "null"
            }
          ]
        },
        "commit_id": {
          "$ref": "#/$defs/CommitId"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "hypothesis_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/HypothesisId"
            },
            {
              "type": "null"
            }
          ]
        },
        "logical_record_id": {
          "$ref": "#/$defs/LogicalRecordId"
        },
        "previous_record_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecordId"
            },
            {
              "type": "null"
            }
          ]
        },
        "record_id": {
          "$ref": "#/$defs/RecordId"
        },
        "record_type": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Record Type",
          "type": "string"
        },
        "revision_number": {
          "minimum": 1,
          "title": "Revision Number",
          "type": "integer"
        },
        "schema_version": {
          "pattern": "^[1-9][0-9]*\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Schema Version",
          "type": "string"
        },
        "workspace_id": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "record_id",
        "logical_record_id",
        "record_type",
        "schema_version",
        "revision_number",
        "previous_record_id",
        "created_at",
        "analysis_id",
        "workspace_id",
        "commit_id",
        "hypothesis_id",
        "attempt_id"
      ],
      "title": "RecordMeta",
      "type": "object"
    },
    "Restriction": {
      "additionalProperties": false,
      "properties": {
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/StoredDataRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "fact_refs": {
          "items": {
            "$ref": "#/$defs/CodeFactRef"
          },
          "title": "Fact Refs",
          "type": "array"
        },
        "restriction_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Restriction Id",
          "type": "string"
        },
        "statement": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "restriction_id",
        "statement",
        "fact_refs",
        "evidence_refs"
      ],
      "title": "Restriction",
      "type": "object"
    },
    "StoredDataId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "StoredDataId",
      "type": "string"
    },
    "StoredDataRef": {
      "additionalProperties": false,
      "properties": {
        "commit_id": {
          "$ref": "#/$defs/CommitId"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "data_kind": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Data Kind",
          "type": "string"
        },
        "record_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecordId"
            },
            {
              "type": "null"
            }
          ]
        },
        "stored_data_id": {
          "$ref": "#/$defs/StoredDataId"
        },
        "workspace_id": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "stored_data_id",
        "data_kind",
        "content_hash",
        "workspace_id",
        "commit_id",
        "record_id"
      ],
      "title": "StoredDataRef",
      "type": "object"
    },
    "ToolSource": {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "$ref": "#/$defs/AttemptId"
        },
        "raw_result_ref": {
          "$ref": "#/$defs/StoredDataRef"
        },
        "rule_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rule Id"
        },
        "tool_name": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Tool Name",
          "type": "string"
        },
        "tool_version": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Tool Version",
          "type": "string"
        }
      },
      "required": [
        "attempt_id",
        "tool_name",
        "tool_version",
        "rule_id",
        "raw_result_ref"
      ],
      "title": "ToolSource",
      "type": "object"
    },
    "ValidationCheck": {
      "additionalProperties": false,
      "properties": {
        "instruction": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Instruction",
          "type": "string"
        },
        "validation_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Validation Id",
          "type": "string"
        }
      },
      "required": [
        "validation_id",
        "instruction"
      ],
      "title": "ValidationCheck",
      "type": "object"
    },
    "WorkId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "WorkId",
      "type": "string"
    },
    "WorkspaceId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "WorkspaceId",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "chained_hypothesis_proposals": {
      "items": {
        "$ref": "#/$defs/HypothesisProposal"
      },
      "title": "Chained Hypothesis Proposals",
      "type": "array"
    },
    "considered_primitive_refs": {
      "items": {
        "$ref": "#/$defs/StoredDataRef"
      },
      "title": "Considered Primitive Refs",
      "type": "array"
    },
    "errors": {
      "items": {
        "$ref": "#/$defs/AnalysisError"
      },
      "title": "Errors",
      "type": "array"
    },
    "excluded_lineage_refs": {
      "items": {
        "$ref": "#/$defs/LineageExclusion"
      },
      "title": "Excluded Lineage Refs",
      "type": "array"
    },
    "input_primitive_refs": {
      "items": {
        "$ref": "#/$defs/StoredDataRef"
      },
      "title": "Input Primitive Refs",
      "type": "array"
    },
    "meta": {
      "$ref": "#/$defs/RecordMeta"
    },
    "no_match_reasons": {
      "items": {
