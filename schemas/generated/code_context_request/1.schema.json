{
  "$defs": {
    "AnalysisId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "AnalysisId",
      "type": "string"
    },
    "AttemptId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "AttemptId",
      "type": "string"
    },
    "CodeLocation": {
      "additionalProperties": false,
      "properties": {
        "commit_id": {
          "$ref": "#/$defs/CommitId"
        },
        "end_column": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "End Column"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "file_path": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "File Path",
          "type": "string"
        },
        "start_column": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Start Column"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        },
        "workspace_id": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "workspace_id",
        "commit_id",
        "file_path",
        "start_line",
        "start_column",
        "end_line",
        "end_column"
      ],
      "title": "CodeLocation",
      "type": "object"
    },
    "CodeSymbol": {
      "additionalProperties": false,
      "properties": {
        "location": {
          "$ref": "#/$defs/CodeLocation"
        },
        "name": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Name",
          "type": "string"
        },
        "native_kind": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Native Kind"
        },
        "symbol_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Symbol Id",
          "type": "string"
        },
        "symbol_kind": {
          "enum": [
            "FILE",
            "MODULE",
            "TYPE",
            "CALLABLE",
            "DATA",
            "ROUTE",
            "CONFIG"
          ],
          "title": "Symbol Kind",
          "type": "string"
        }
      },
      "required": [
        "symbol_id",
        "symbol_kind",
        "native_kind",
        "name",
        "location"
      ],
      "title": "CodeSymbol",
      "type": "object"
    },
    "CommitId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "CommitId",
      "type": "string"
    },
    "ContextRetrievalLimits": {
      "additionalProperties": false,
      "properties": {
        "max_bytes": {
          "minimum": 1,
          "title": "Max Bytes",
          "type": "integer"
        },
        "max_depth": {
          "minimum": 1,
          "title": "Max Depth",
          "type": "integer"
        },
        "max_fragments": {
          "minimum": 1,
          "title": "Max Fragments",
          "type": "integer"
        },
        "max_requests_per_hypothesis": {
          "minimum": 1,
          "title": "Max Requests Per Hypothesis",
          "type": "integer"
        },
        "timeout_ms": {
          "minimum": 1,
          "title": "Timeout Ms",
          "type": "integer"
        }
      },
      "required": [
        "max_depth",
        "max_fragments",
        "max_bytes",
        "max_requests_per_hypothesis",
        "timeout_ms"
      ],
      "title": "ContextRetrievalLimits",
      "type": "object"
    },
    "HypothesisId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "HypothesisId",
      "type": "string"
    },
    "LogicalRecordId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "LogicalRecordId",
      "type": "string"
    },
    "RecordId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "RecordId",
      "type": "string"
    },
    "RecordMeta": {
      "additionalProperties": false,
      "properties": {
        "analysis_id": {
          "$ref": "#/$defs/AnalysisId"
        },
        "attempt_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/AttemptId"
            },
            {
              "type": "null"
            }
          ]
        },
        "commit_id": {
          "$ref": "#/$defs/CommitId"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "hypothesis_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/HypothesisId"
            },
            {
              "type": "null"
            }
          ]
        },
        "logical_record_id": {
          "$ref": "#/$defs/LogicalRecordId"
        },
        "previous_record_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecordId"
            },
            {
              "type": "null"
            }
          ]
        },
        "record_id": {
          "$ref": "#/$defs/RecordId"
        },
        "record_type": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Record Type",
          "type": "string"
        },
        "revision_number": {
          "minimum": 1,
          "title": "Revision Number",
          "type": "integer"
        },
        "schema_version": {
          "pattern": "^[1-9][0-9]*\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Schema Version",
          "type": "string"
        },
        "workspace_id": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "record_id",
        "logical_record_id",
        "record_type",
        "schema_version",
        "revision_number",
        "previous_record_id",
        "created_at",
        "analysis_id",
        "workspace_id",
        "commit_id",
        "hypothesis_id",
        "attempt_id"
      ],
      "title": "RecordMeta",
      "type": "object"
    },
    "StoredDataId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "StoredDataId",
      "type": "string"
    },
    "StoredDataRef": {
      "additionalProperties": false,
      "properties": {
        "commit_id": {
          "$ref": "#/$defs/CommitId"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "data_kind": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Data Kind",
          "type": "string"
        },
        "record_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecordId"
            },
            {
              "type": "null"
            }
          ]
        },
        "stored_data_id": {
          "$ref": "#/$defs/StoredDataId"
        },
        "workspace_id": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "stored_data_id",
        "data_kind",
        "content_hash",
        "workspace_id",
        "commit_id",
        "record_id"
      ],
      "title": "StoredDataRef",
      "type": "object"
    },
    "WorkspaceId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "WorkspaceId",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action_decision_ref": {
      "$ref": "#/$defs/StoredDataRef"
    },
    "code_request_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Code Request Id",
      "type": "string"
    },
    "limits": {
      "$ref": "#/$defs/ContextRetrievalLimits"
    },
    "meta": {
      "$ref": "#/$defs/RecordMeta"
    },
    "reason": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Reason",
      "type": "string"
    },
    "relation_query": {
      "items": {
        "enum": [
          "CALLERS",
          "CALLEES",
          "DATA_FLOW_NEIGHBORS",
          "AUTH_GUARDS",
          "ROUTE_BINDINGS"
        ],
        "type": "string"
      },
      "title": "Relation Query",
      "type": "array"
    },
    "requested_entities": {
      "items": {
        "$ref": "#/$defs/CodeSymbol"
      },
      "title": "Requested Entities",
      "type": "array"
    },
    "requested_locations": {
      "items": {
        "$ref": "#/$defs/CodeLocation"
      },
      "title": "Requested Locations",
      "type": "array"
    }
  },
  "required": [
    "meta",
    "code_request_id",
    "action_decision_ref",
    "requested_entities",
    "requested_locations",
    "relation_query",
    "reason",
    "limits"
  ],
  "title": "CodeContextRequest",
  "type": "object"
}
