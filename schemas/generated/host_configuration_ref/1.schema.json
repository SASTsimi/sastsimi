{
  "$defs": {
    "AnalysisId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "AnalysisId",
      "type": "string"
    },
    "CommitId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "CommitId",
      "type": "string"
    },
    "RecordId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "RecordId",
      "type": "string"
    },
    "StoredDataId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "StoredDataId",
      "type": "string"
    },
    "WorkspaceId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "WorkspaceId",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Exact host configuration revision reusable across repository analyses.",
  "properties": {
    "configuration_scope": {
      "const": "HOST",
      "default": "HOST",
      "title": "Configuration Scope",
      "type": "string"
    },
    "content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "data_kind": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Data Kind",
      "type": "string"
    },
    "host_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Host Id",
      "type": "string"
    },
    "publication_analysis_id": {
      "$ref": "#/$defs/AnalysisId"
    },
    "publication_commit_id": {
      "$ref": "#/$defs/CommitId"
    },
    "publication_workspace_id": {
      "$ref": "#/$defs/WorkspaceId"
    },
    "record_id": {
      "$ref": "#/$defs/RecordId"
    },
    "stored_data_id": {
      "$ref": "#/$defs/StoredDataId"
    }
  },
  "required": [
    "stored_data_id",
    "data_kind",
    "content_hash",
    "host_id",
    "publication_analysis_id",
    "publication_workspace_id",
    "publication_commit_id",
    "record_id"
  ],
  "title": "HostConfigurationRef",
  "type": "object"
}
