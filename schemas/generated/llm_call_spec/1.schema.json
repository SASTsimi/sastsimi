{
  "$defs": {
    "AnalysisId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "AnalysisId",
      "type": "string"
    },
    "AttemptId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "AttemptId",
      "type": "string"
    },
    "CommitId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "CommitId",
      "type": "string"
    },
    "HypothesisId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "HypothesisId",
      "type": "string"
    },
    "LLMRole": {
      "enum": [
        "HYPOTHESIS",
        "VERIFICATION",
        "PRO",
        "CON",
        "CWE_LABELING",
        "CHAINING",
        "TECHNICAL_GATE",
        "RULE_SCOPE_GATE",
        "REPORTER",
        "POLICY_PARSER",
        "DYNAMIC_REPRODUCTION"
      ],
      "type": "string"
    },
    "LogicalRecordId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "LogicalRecordId",
      "type": "string"
    },
    "Purpose": {
      "enum": [
        "EVALUATION",
        "PRODUCTION"
      ],
      "type": "string"
    },
    "RecordId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "RecordId",
      "type": "string"
    },
    "RecordMeta": {
      "additionalProperties": false,
      "properties": {
        "analysis_id": {
          "$ref": "#/$defs/AnalysisId"
        },
        "attempt_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/AttemptId"
            },
            {
              "type": "null"
            }
          ]
        },
        "commit_id": {
          "$ref": "#/$defs/CommitId"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "hypothesis_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/HypothesisId"
            },
            {
              "type": "null"
            }
          ]
        },
        "logical_record_id": {
          "$ref": "#/$defs/LogicalRecordId"
        },
        "previous_record_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecordId"
            },
            {
              "type": "null"
            }
          ]
        },
        "record_id": {
          "$ref": "#/$defs/RecordId"
        },
        "record_type": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Record Type",
          "type": "string"
        },
        "revision_number": {
          "minimum": 1,
          "title": "Revision Number",
          "type": "integer"
        },
        "schema_version": {
          "pattern": "^[1-9][0-9]*\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Schema Version",
          "type": "string"
        },
        "workspace_id": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "record_id",
        "logical_record_id",
        "record_type",
        "schema_version",
        "revision_number",
        "previous_record_id",
        "created_at",
        "analysis_id",
        "workspace_id",
        "commit_id",
        "hypothesis_id",
        "attempt_id"
      ],
      "title": "RecordMeta",
      "type": "object"
    },
    "SessionPolicy": {
      "enum": [
        "NEW",
        "RESUME",
        "AUTO"
      ],
      "type": "string"
    },
    "StoredDataId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "StoredDataId",
      "type": "string"
    },
    "StoredDataRef": {
      "additionalProperties": false,
      "properties": {
        "commit_id": {
          "$ref": "#/$defs/CommitId"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "data_kind": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Data Kind",
          "type": "string"
        },
        "record_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecordId"
            },
            {
              "type": "null"
            }
          ]
        },
        "stored_data_id": {
          "$ref": "#/$defs/StoredDataId"
        },
        "workspace_id": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "stored_data_id",
        "data_kind",
        "content_hash",
        "workspace_id",
        "commit_id",
        "record_id"
      ],
      "title": "StoredDataRef",
      "type": "object"
    },
    "WorkspaceId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "WorkspaceId",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "agent_role": {
      "$ref": "#/$defs/LLMRole"
    },
    "context_refs": {
      "items": {
        "$ref": "#/$defs/StoredDataRef"
      },
      "title": "Context Refs",
      "type": "array"
    },
    "execution_limits_ref": {
      "$ref": "#/$defs/StoredDataRef"
    },
    "llm_call_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Llm Call Id",
      "type": "string"
    },
    "meta": {
      "$ref": "#/$defs/RecordMeta"
    },
    "model": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Model",
      "type": "string"
    },
    "output_schema": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Output Schema",
      "type": "string"
    },
    "output_schema_ref": {
      "$ref": "#/$defs/StoredDataRef"
    },
    "parent_session_ref": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Parent Session Ref"
    },
    "prompt_key": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Prompt Key",
      "type": "string"
    },
    "prompt_payload_ref": {
      "$ref": "#/$defs/StoredDataRef"
    },
    "prompt_registry_entry_ref": {
      "$ref": "#/$defs/StoredDataRef"
    },
    "prompt_template_ref": {
      "$ref": "#/$defs/StoredDataRef"
    },
    "prompt_template_version": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Prompt Template Version",
      "type": "string"
    },
    "provider_profile_ref": {
      "$ref": "#/$defs/StoredDataRef"
    },
    "purpose": {
      "$ref": "#/$defs/Purpose"
    },
    "redaction_policy_ref": {
      "$ref": "#/$defs/StoredDataRef"
    },
    "retry_policy_ref": {
      "$ref": "#/$defs/StoredDataRef"
    },
    "semantic_validator_ref": {
      "$ref": "#/$defs/StoredDataRef"
    },
    "session_policy": {
      "$ref": "#/$defs/SessionPolicy"
    },
    "task_kind": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Task Kind",
      "type": "string"
    },
    "timeout_ms": {
      "minimum": 1,
      "title": "Timeout Ms",
      "type": "integer"
    },
    "token_budget": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Token Budget"
    },
    "tool_policy_ref": {
      "$ref": "#/$defs/StoredDataRef"
    }
  },
  "required": [
    "meta",
    "llm_call_id",
    "agent_role",
    "task_kind",
    "purpose",
    "provider_profile_ref",
    "model",
    "session_policy",
    "parent_session_ref",
    "context_refs",
    "prompt_registry_entry_ref",
    "prompt_key",
    "prompt_template_ref",
    "prompt_template_version",
    "prompt_payload_ref",
    "execution_limits_ref",
    "retry_policy_ref",
    "tool_policy_ref",
    "redaction_policy_ref",
    "semantic_validator_ref",
    "output_schema_ref",
    "output_schema",
    "token_budget",
    "timeout_ms"
  ],
  "title": "LLMCallSpec",
  "type": "object"
}
