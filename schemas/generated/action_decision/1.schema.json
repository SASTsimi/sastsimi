{
  "$defs": {
    "ActionCheck": {
      "additionalProperties": false,
      "properties": {
        "check_type": {
          "$ref": "#/$defs/CheckType"
        },
        "reason_code": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Reason Code",
          "type": "string"
        },
        "result": {
          "$ref": "#/$defs/CheckResult"
        },
        "safe_message": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Safe Message",
          "type": "string"
        }
      },
      "required": [
        "check_type",
        "result",
        "reason_code",
        "safe_message"
      ],
      "title": "ActionCheck",
      "type": "object"
    },
    "AnalysisId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "AnalysisId",
      "type": "string"
    },
    "AttemptId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "AttemptId",
      "type": "string"
    },
    "BudgetScopeRef": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunStoredDataRef"
        },
        {
          "$ref": "#/$defs/StoredDataRef"
        }
      ]
    },
    "CheckResult": {
      "enum": [
        "PASS",
        "FAIL"
      ],
      "title": "CheckResult",
      "type": "string"
    },
    "CheckType": {
      "enum": [
        "SCHEMA",
        "AUTHORITY",
        "IDENTITY",
        "REVISION",
        "STATE",
        "BUDGET",
        "TOOL",
        "FILE_PATH",
        "PROVIDER",
        "SESSION",
        "GATE_ORDER",
        "REPORT_READY",
        "REDACTION"
      ],
      "title": "CheckType",
      "type": "string"
    },
    "CommitId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "CommitId",
      "type": "string"
    },
    "Decision": {
      "enum": [
        "ALLOW",
        "DENY"
      ],
      "title": "Decision",
      "type": "string"
    },
    "DecisionId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "DecisionId",
      "type": "string"
    },
    "ErrorId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "ErrorId",
      "type": "string"
    },
    "HypothesisId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "HypothesisId",
      "type": "string"
    },
    "LogicalRecordId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "LogicalRecordId",
      "type": "string"
    },
    "PolicyCacheRef": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "data_kind": {
          "const": "policy_cache_record",
          "title": "Data Kind",
          "type": "string"
        },
        "program_id": {
          "$ref": "#/$defs/ProgramId"
        },
        "record_id": {
          "$ref": "#/$defs/RecordId"
        },
        "schema_version": {
          "pattern": "^[1-9][0-9]*\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Schema Version",
          "type": "string"
        },
        "stored_data_id": {
          "$ref": "#/$defs/StoredDataId"
        }
      },
      "required": [
        "stored_data_id",
        "data_kind",
        "record_id",
        "content_hash",
        "program_id",
        "schema_version"
      ],
      "title": "PolicyCacheRef",
      "type": "object"
    },
    "ProgramId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "ProgramId",
      "type": "string"
    },
    "RecordId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "RecordId",
      "type": "string"
    },
    "RecordMeta": {
      "additionalProperties": false,
      "properties": {
        "analysis_id": {
          "$ref": "#/$defs/AnalysisId"
        },
        "attempt_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/AttemptId"
            },
            {
              "type": "null"
            }
          ]
        },
        "commit_id": {
          "$ref": "#/$defs/CommitId"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "hypothesis_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/HypothesisId"
            },
            {
              "type": "null"
            }
          ]
        },
        "logical_record_id": {
          "$ref": "#/$defs/LogicalRecordId"
        },
        "previous_record_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecordId"
            },
            {
              "type": "null"
            }
          ]
        },
        "record_id": {
          "$ref": "#/$defs/RecordId"
        },
        "record_type": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Record Type",
          "type": "string"
        },
        "revision_number": {
          "minimum": 1,
          "title": "Revision Number",
          "type": "integer"
        },
        "schema_version": {
          "pattern": "^[1-9][0-9]*\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Schema Version",
          "type": "string"
        },
        "workspace_id": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "record_id",
        "logical_record_id",
        "record_type",
        "schema_version",
        "revision_number",
        "previous_record_id",
        "created_at",
        "analysis_id",
        "workspace_id",
        "commit_id",
        "hypothesis_id",
        "attempt_id"
      ],
      "title": "RecordMeta",
      "type": "object"
    },
    "RecordRef": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunStoredDataRef"
        },
        {
          "$ref": "#/$defs/StoredDataRef"
        },
        {
          "$ref": "#/$defs/PolicyCacheRef"
        }
      ]
    },
    "RunMeta": {
      "additionalProperties": false,
      "properties": {
        "analysis_id": {
          "$ref": "#/$defs/AnalysisId"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "logical_record_id": {
          "$ref": "#/$defs/LogicalRecordId"
        },
        "previous_record_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecordId"
            },
            {
              "type": "null"
            }
          ]
        },
        "record_id": {
          "$ref": "#/$defs/RecordId"
        },
        "record_type": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Record Type",
          "type": "string"
        },
        "revision_number": {
          "minimum": 1,
          "title": "Revision Number",
          "type": "integer"
        },
        "schema_version": {
          "pattern": "^[1-9][0-9]*\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "logical_record_id",
        "record_type",
        "schema_version",
        "revision_number",
        "previous_record_id",
        "created_at",
        "analysis_id"
      ],
      "title": "RunMeta",
      "type": "object"
    },
    "RunStoredDataRef": {
      "additionalProperties": false,
      "properties": {
        "analysis_id": {
          "$ref": "#/$defs/AnalysisId"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "data_kind": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Data Kind",
          "type": "string"
        },
        "record_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecordId"
            },
            {
              "type": "null"
            }
          ]
        },
        "stored_data_id": {
          "$ref": "#/$defs/StoredDataId"
        }
      },
      "required": [
        "stored_data_id",
        "data_kind",
        "content_hash",
        "analysis_id",
        "record_id"
      ],
      "title": "RunStoredDataRef",
      "type": "object"
    },
    "StoredDataId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "StoredDataId",
      "type": "string"
    },
    "StoredDataRef": {
      "additionalProperties": false,
      "properties": {
        "commit_id": {
          "$ref": "#/$defs/CommitId"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "data_kind": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Data Kind",
          "type": "string"
        },
        "record_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecordId"
            },
            {
              "type": "null"
            }
          ]
        },
        "stored_data_id": {
          "$ref": "#/$defs/StoredDataId"
        },
        "workspace_id": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "stored_data_id",
        "data_kind",
        "content_hash",
        "workspace_id",
        "commit_id",
        "record_id"
      ],
      "title": "StoredDataRef",
      "type": "object"
    },
    "UseStatus": {
      "enum": [
        "UNUSED",
        "USED",
        "NOT_USED",
        "EXPIRED"
      ],
      "title": "UseStatus",
      "type": "string"
    },
    "WorkspaceId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "WorkspaceId",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action_ref": {
      "$ref": "#/$defs/BudgetScopeRef"
    },
    "check_results": {
      "items": {
        "$ref": "#/$defs/ActionCheck"
      },
      "title": "Check Results",
      "type": "array"
    },
    "checked_config_refs": {
      "items": {
        "$ref": "#/$defs/BudgetScopeRef"
      },
      "title": "Checked Config Refs",
      "type": "array"
    },
    "checked_state_version": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Checked State Version"
    },
    "decided_at": {
      "format": "date-time",
      "title": "Decided At",
      "type": "string"
    },
    "decision": {
      "$ref": "#/$defs/Decision"
    },
    "decision_id": {
      "$ref": "#/$defs/DecisionId"
    },
    "error_ids": {
      "items": {
        "$ref": "#/$defs/ErrorId"
      },
      "title": "Error Ids",
      "type": "array"
    },
    "expire_reason": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Expire Reason"
    },
    "expired_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Expired At"
    },
    "meta": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunMeta"
        },
        {
          "$ref": "#/$defs/RecordMeta"
        }
      ],
      "title": "Meta"
    },
    "outcome_refs": {
      "items": {
        "$ref": "#/$defs/RecordRef"
      },
      "title": "Outcome Refs",
      "type": "array"
    },
    "required_checks": {
      "items": {
        "$ref": "#/$defs/CheckType"
      },
      "title": "Required Checks",
      "type": "array"
    },
    "use_status": {
      "$ref": "#/$defs/UseStatus"
    },
    "used_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Used At"
    },
    "valid_until": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Valid Until"
    }
  },
  "required": [
    "meta",
    "decision_id",
    "action_ref",
    "decision",
    "required_checks",
    "check_results",
    "checked_state_version",
    "checked_config_refs",
    "valid_until",
    "error_ids",
    "use_status",
    "used_at",
    "expired_at",
    "expire_reason",
    "outcome_refs",
    "decided_at"
  ],
  "title": "ActionDecision",
  "type": "object"
}
