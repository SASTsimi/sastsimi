{
  "$defs": {
    "AnalysisId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "AnalysisId",
      "type": "string"
    },
    "AttemptId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "AttemptId",
      "type": "string"
    },
    "CommitId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "CommitId",
      "type": "string"
    },
    "HypothesisId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "HypothesisId",
      "type": "string"
    },
    "LogicalRecordId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "LogicalRecordId",
      "type": "string"
    },
    "PolicyArea": {
      "enum": [
        "RULE",
        "SCOPE",
        "IMPACT",
        "SOURCE",
        "FRESHNESS",
        "TESTING_RESTRICTION"
      ],
      "type": "string"
    },
    "PolicyMissingInfo": {
      "additionalProperties": false,
      "properties": {
        "area": {
          "$ref": "#/$defs/PolicyArea"
        },
        "blocks_allow": {
          "title": "Blocks Allow",
          "type": "boolean"
        },
        "description": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Description",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/StoredDataRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "missing_info_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Missing Info Id",
          "type": "string"
        },
        "policy_item_ids": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Policy Item Ids",
          "type": "array"
        }
      },
      "required": [
        "missing_info_id",
        "area",
        "blocks_allow",
        "description",
        "policy_item_ids",
        "evidence_refs"
      ],
      "title": "PolicyMissingInfo",
      "type": "object"
    },
    "RecordId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "RecordId",
      "type": "string"
    },
    "RecordMeta": {
      "additionalProperties": false,
      "properties": {
        "analysis_id": {
          "$ref": "#/$defs/AnalysisId"
        },
        "attempt_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/AttemptId"
            },
            {
              "type": "null"
            }
          ]
        },
        "commit_id": {
          "$ref": "#/$defs/CommitId"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "hypothesis_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/HypothesisId"
            },
            {
              "type": "null"
            }
          ]
        },
        "logical_record_id": {
          "$ref": "#/$defs/LogicalRecordId"
        },
        "previous_record_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecordId"
            },
            {
              "type": "null"
            }
          ]
        },
        "record_id": {
          "$ref": "#/$defs/RecordId"
        },
        "record_type": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Record Type",
          "type": "string"
        },
        "revision_number": {
          "minimum": 1,
          "title": "Revision Number",
          "type": "integer"
        },
        "schema_version": {
          "pattern": "^[1-9][0-9]*\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Schema Version",
          "type": "string"
        },
        "workspace_id": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "record_id",
        "logical_record_id",
        "record_type",
        "schema_version",
        "revision_number",
        "previous_record_id",
        "created_at",
        "analysis_id",
        "workspace_id",
        "commit_id",
        "hypothesis_id",
        "attempt_id"
      ],
      "title": "RecordMeta",
      "type": "object"
    },
    "RuleScopeEvidenceLink": {
      "additionalProperties": false,
      "properties": {
        "area": {
          "enum": [
            "RULE",
            "SCOPE",
            "IMPACT",
            "TESTING_RESTRICTION"
          ],
          "title": "Area",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/StoredDataRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "link_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Link Id",
          "type": "string"
        },
        "policy_item_ids": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Policy Item Ids",
          "type": "array"
        }
      },
      "required": [
        "link_id",
        "area",
        "policy_item_ids",
        "evidence_refs"
      ],
      "title": "RuleScopeEvidenceLink",
      "type": "object"
    },
    "StoredDataId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "StoredDataId",
      "type": "string"
    },
    "StoredDataRef": {
      "additionalProperties": false,
      "properties": {
        "commit_id": {
          "$ref": "#/$defs/CommitId"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "data_kind": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Data Kind",
          "type": "string"
        },
        "record_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecordId"
            },
            {
              "type": "null"
            }
          ]
        },
        "stored_data_id": {
          "$ref": "#/$defs/StoredDataId"
        },
        "workspace_id": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "stored_data_id",
        "data_kind",
        "content_hash",
        "workspace_id",
        "commit_id",
        "record_id"
      ],
      "title": "StoredDataRef",
      "type": "object"
    },
    "WorkspaceId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "WorkspaceId",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action_decision_ref": {
      "$ref": "#/$defs/StoredDataRef"
    },
    "cwe_label_ref": {
      "$ref": "#/$defs/StoredDataRef"
    },
    "evidence_links": {
      "items": {
        "$ref": "#/$defs/RuleScopeEvidenceLink"
      },
      "title": "Evidence Links",
      "type": "array"
    },
    "meta": {
      "$ref": "#/$defs/RecordMeta"
    },
    "missing_information": {
      "items": {
        "$ref": "#/$defs/PolicyMissingInfo"
      },
      "title": "Missing Information",
      "type": "array"
    },
    "policy_collection_result_ref": {
      "$ref": "#/$defs/StoredDataRef"
    },
    "policy_record_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/StoredDataRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "reasons": {
      "items": {
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "title": "Reasons",
      "type": "array"
    },
    "report_permission": {
      "enum": [
        "ALLOW",
        "DENY"
      ],
      "title": "Report Permission",
      "type": "string"
    },
    "review_status": {
      "enum": [
        "PASS",
        "FAIL",
        "UNCERTAIN"
      ],
      "title": "Review Status",
      "type": "string"
    },
    "rule_compliance": {
      "enum": [
        "PASS",
        "FAIL",
        "UNCERTAIN"
      ],
      "title": "Rule Compliance",
      "type": "string"
    },
    "run_policy_state_ref": {
      "$ref": "#/$defs/StoredDataRef"
    },
    "scope_compliance": {
      "enum": [
        "PASS",
        "FAIL",
        "UNCERTAIN"
      ],
      "title": "Scope Compliance",
      "type": "string"
    },
    "security_impact": {
      "enum": [
        "SUFFICIENT",
        "INSUFFICIENT",
        "UNCERTAIN"
      ],
      "title": "Security Impact",
      "type": "string"
    },
    "technical_review_ref": {
      "$ref": "#/$defs/StoredDataRef"
    },
    "testing_restriction_compliance": {
      "enum": [
        "PASS",
        "FAIL",
        "UNCERTAIN"
      ],
      "title": "Testing Restriction Compliance",
      "type": "string"
    },
    "verification_result_ref": {
      "$ref": "#/$defs/StoredDataRef"
    }
  },
  "required": [
    "meta",
    "action_decision_ref",
    "verification_result_ref",
    "technical_review_ref",
    "cwe_label_ref",
    "run_policy_state_ref",
    "policy_collection_result_ref",
    "policy_record_ref",
    "review_status",
    "rule_compliance",
    "scope_compliance",
    "testing_restriction_compliance",
    "security_impact",
    "report_permission",
    "evidence_links",
    "reasons",
    "missing_information"
  ],
  "title": "RuleScopeImpactReview",
  "type": "object"
}
