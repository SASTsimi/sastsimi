{
  "$defs": {
    "AnalysisId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "AnalysisId",
      "type": "string"
    },
    "AttemptId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "AttemptId",
      "type": "string"
    },
    "CommitId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "CommitId",
      "type": "string"
    },
    "EnvironmentRecipeSourceManifest": {
      "additionalProperties": false,
      "description": "Durable exact inputs needed to rebuild one repository-backed recipe.",
      "properties": {
        "build_context_ref": {
          "$ref": "#/$defs/StoredDataRef"
        },
        "context_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Context Digest",
          "type": "string"
        },
        "dockerfile_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Dockerfile Digest",
          "type": "string"
        },
        "dockerfile_origin": {
          "enum": [
            "REPOSITORY",
            "GENERATED"
          ],
          "title": "Dockerfile Origin",
          "type": "string"
        },
        "dockerfile_path": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Dockerfile Path",
          "type": "string"
        },
        "dockerfile_ref": {
          "$ref": "#/$defs/StoredDataRef"
        },
        "repository_profile_ref": {
          "$ref": "#/$defs/StoredDataRef"
        }
      },
      "required": [
        "repository_profile_ref",
        "dockerfile_ref",
        "build_context_ref",
        "dockerfile_path",
        "dockerfile_origin",
        "dockerfile_digest",
        "context_digest"
      ],
      "title": "EnvironmentRecipeSourceManifest",
      "type": "object"
    },
    "HypothesisId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "HypothesisId",
      "type": "string"
    },
    "LogicalRecordId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "LogicalRecordId",
      "type": "string"
    },
    "RecordId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "RecordId",
      "type": "string"
    },
    "RecordMeta": {
      "additionalProperties": false,
      "properties": {
        "analysis_id": {
          "$ref": "#/$defs/AnalysisId"
        },
        "attempt_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/AttemptId"
            },
            {
              "type": "null"
            }
          ]
        },
        "commit_id": {
          "$ref": "#/$defs/CommitId"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "hypothesis_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/HypothesisId"
            },
            {
              "type": "null"
            }
          ]
        },
        "logical_record_id": {
          "$ref": "#/$defs/LogicalRecordId"
        },
        "previous_record_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecordId"
            },
            {
              "type": "null"
            }
          ]
        },
        "record_id": {
          "$ref": "#/$defs/RecordId"
        },
        "record_type": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Record Type",
          "type": "string"
        },
        "revision_number": {
          "minimum": 1,
          "title": "Revision Number",
          "type": "integer"
        },
        "schema_version": {
          "pattern": "^[1-9][0-9]*\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Schema Version",
          "type": "string"
        },
        "workspace_id": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "record_id",
        "logical_record_id",
        "record_type",
        "schema_version",
        "revision_number",
        "previous_record_id",
        "created_at",
        "analysis_id",
        "workspace_id",
        "commit_id",
        "hypothesis_id",
        "attempt_id"
      ],
      "title": "RecordMeta",
      "type": "object"
    },
    "StoredDataId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "StoredDataId",
      "type": "string"
    },
    "StoredDataRef": {
      "additionalProperties": false,
      "properties": {
        "commit_id": {
          "$ref": "#/$defs/CommitId"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "data_kind": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Data Kind",
          "type": "string"
        },
        "record_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecordId"
            },
            {
              "type": "null"
            }
          ]
        },
        "stored_data_id": {
          "$ref": "#/$defs/StoredDataId"
        },
        "workspace_id": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "stored_data_id",
        "data_kind",
        "content_hash",
        "workspace_id",
        "commit_id",
        "record_id"
      ],
      "title": "StoredDataRef",
      "type": "object"
    },
    "WorkspaceId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "WorkspaceId",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "base_image_digest": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Base Image Digest",
      "type": "string"
    },
    "baseline_recipe_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/StoredDataRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "build_disposition": {
      "enum": [
        "BUILT",
        "REUSED"
      ],
      "title": "Build Disposition",
      "type": "string"
    },
    "built_image_digest": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Built Image Digest",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "environment_requirements_ref": {
      "$ref": "#/$defs/StoredDataRef"
    },
    "meta": {
      "$ref": "#/$defs/RecordMeta"
    },
    "recipe_source_ref": {
      "$ref": "#/$defs/StoredDataRef"
    },
    "request_ref": {
      "$ref": "#/$defs/StoredDataRef"
    },
    "source_manifest": {
      "anyOf": [
        {
          "$ref": "#/$defs/EnvironmentRecipeSourceManifest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "source_refs": {
      "items": {
        "$ref": "#/$defs/StoredDataRef"
      },
      "title": "Source Refs",
      "type": "array"
    }
  },
  "required": [
    "meta",
    "request_ref",
    "environment_requirements_ref",
    "recipe_source_ref",
    "source_refs",
    "base_image_digest",
    "built_image_digest",
    "baseline_recipe_ref",
    "build_disposition",
    "created_at"
  ],
  "title": "EnvironmentRecipe",
  "type": "object"
}
