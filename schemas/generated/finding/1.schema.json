{
  "$defs": {
    "AnalysisId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "AnalysisId",
      "type": "string"
    },
    "AttemptId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "AttemptId",
      "type": "string"
    },
    "CommitId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "CommitId",
      "type": "string"
    },
    "FindingConditionSource": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "RESTRICTION",
            "LIMITATION",
            "UNRESOLVED_CONDITION"
          ],
          "title": "Kind",
          "type": "string"
        },
        "source_path": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source Path",
          "type": "string"
        },
        "source_ref": {
          "$ref": "#/$defs/StoredDataRef"
        }
      },
      "required": [
        "kind",
        "source_ref",
        "source_path"
      ],
      "title": "FindingConditionSource",
      "type": "object"
    },
    "HypothesisId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "HypothesisId",
      "type": "string"
    },
    "LogicalRecordId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "LogicalRecordId",
      "type": "string"
    },
    "RecordId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "RecordId",
      "type": "string"
    },
    "RecordMeta": {
      "additionalProperties": false,
      "properties": {
        "analysis_id": {
          "$ref": "#/$defs/AnalysisId"
        },
        "attempt_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/AttemptId"
            },
            {
              "type": "null"
            }
          ]
        },
        "commit_id": {
          "$ref": "#/$defs/CommitId"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "hypothesis_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/HypothesisId"
            },
            {
              "type": "null"
            }
          ]
        },
        "logical_record_id": {
          "$ref": "#/$defs/LogicalRecordId"
        },
        "previous_record_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecordId"
            },
            {
              "type": "null"
            }
          ]
        },
        "record_id": {
          "$ref": "#/$defs/RecordId"
        },
        "record_type": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Record Type",
          "type": "string"
        },
        "revision_number": {
          "minimum": 1,
          "title": "Revision Number",
          "type": "integer"
        },
        "schema_version": {
          "pattern": "^[1-9][0-9]*\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Schema Version",
          "type": "string"
        },
        "workspace_id": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "record_id",
        "logical_record_id",
        "record_type",
        "schema_version",
        "revision_number",
        "previous_record_id",
        "created_at",
        "analysis_id",
        "workspace_id",
        "commit_id",
        "hypothesis_id",
        "attempt_id"
      ],
      "title": "RecordMeta",
      "type": "object"
    },
    "StoredDataId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "StoredDataId",
      "type": "string"
    },
    "StoredDataRef": {
      "additionalProperties": false,
      "properties": {
        "commit_id": {
          "$ref": "#/$defs/CommitId"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "data_kind": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Data Kind",
          "type": "string"
        },
        "record_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecordId"
            },
            {
              "type": "null"
            }
          ]
        },
        "stored_data_id": {
          "$ref": "#/$defs/StoredDataId"
        },
        "workspace_id": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "stored_data_id",
        "data_kind",
        "content_hash",
        "workspace_id",
        "commit_id",
        "record_id"
      ],
      "title": "StoredDataRef",
      "type": "object"
    },
    "WorkspaceId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "WorkspaceId",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "condition_sources": {
      "items": {
        "$ref": "#/$defs/FindingConditionSource"
      },
      "title": "Condition Sources",
      "type": "array"
    },
    "cwe_label_ref": {
      "$ref": "#/$defs/StoredDataRef"
    },
    "dynamic_result_ref": {
      "$ref": "#/$defs/StoredDataRef"
    },
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/StoredDataRef"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "meta": {
      "$ref": "#/$defs/RecordMeta"
    },
    "poc_ref": {
      "$ref": "#/$defs/StoredDataRef"
    },
    "policy_collection_result_ref": {
      "$ref": "#/$defs/StoredDataRef"
    },
    "policy_record_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/StoredDataRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "rule_scope_impact_review_ref": {
      "$ref": "#/$defs/StoredDataRef"
    },
    "technical_review_ref": {
      "$ref": "#/$defs/StoredDataRef"
    },
    "verification_result_ref": {
      "$ref": "#/$defs/StoredDataRef"
    }
  },
  "required": [
    "meta",
    "verification_result_ref",
    "dynamic_result_ref",
    "poc_ref",
    "cwe_label_ref",
    "technical_review_ref",
    "rule_scope_impact_review_ref",
    "policy_collection_result_ref",
    "policy_record_ref",
    "evidence_refs",
    "condition_sources"
  ],
  "title": "Finding",
  "type": "object"
}
