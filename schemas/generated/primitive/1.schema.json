{
  "$defs": {
    "AnalysisId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "AnalysisId",
      "type": "string"
    },
    "AttemptId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "AttemptId",
      "type": "string"
    },
    "CodeFactRef": {
      "additionalProperties": false,
      "properties": {
        "bundle_ref": {
          "$ref": "#/$defs/StoredDataRef"
        },
        "fact_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Fact Id",
          "type": "string"
        }
      },
      "required": [
        "bundle_ref",
        "fact_id"
      ],
      "title": "CodeFactRef",
      "type": "object"
    },
    "CodeLocation": {
      "additionalProperties": false,
      "properties": {
        "commit_id": {
          "$ref": "#/$defs/CommitId"
        },
        "end_column": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "End Column"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "file_path": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "File Path",
          "type": "string"
        },
        "start_column": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Start Column"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        },
        "workspace_id": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "workspace_id",
        "commit_id",
        "file_path",
        "start_line",
        "start_column",
        "end_line",
        "end_column"
      ],
      "title": "CodeLocation",
      "type": "object"
    },
    "CodeSymbol": {
      "additionalProperties": false,
      "properties": {
        "location": {
          "$ref": "#/$defs/CodeLocation"
        },
        "name": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Name",
          "type": "string"
        },
        "native_kind": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Native Kind"
        },
        "symbol_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Symbol Id",
          "type": "string"
        },
        "symbol_kind": {
          "enum": [
            "FILE",
            "MODULE",
            "TYPE",
            "CALLABLE",
            "DATA",
            "ROUTE",
            "CONFIG"
          ],
          "title": "Symbol Kind",
          "type": "string"
        }
      },
      "required": [
        "symbol_id",
        "symbol_kind",
        "native_kind",
        "name",
        "location"
      ],
      "title": "CodeSymbol",
      "type": "object"
    },
    "CommitId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "CommitId",
      "type": "string"
    },
    "HypothesisId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "HypothesisId",
      "type": "string"
    },
    "LogicalRecordId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "LogicalRecordId",
      "type": "string"
    },
    "PrimitiveDraft": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Description",
          "type": "string"
        },
        "draft_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Draft Id",
          "type": "string"
        },
        "entity_refs": {
          "items": {
            "$ref": "#/$defs/CodeSymbol"
          },
          "title": "Entity Refs",
          "type": "array"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/StoredDataRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "privilege_level": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Privilege Level"
        }
      },
      "required": [
        "draft_id",
        "entity_refs",
        "privilege_level",
        "evidence_refs",
        "description"
      ],
      "title": "PrimitiveDraft",
      "type": "object"
    },
    "RecordId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "RecordId",
      "type": "string"
    },
    "RecordMeta": {
      "additionalProperties": false,
      "properties": {
        "analysis_id": {
          "$ref": "#/$defs/AnalysisId"
        },
        "attempt_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/AttemptId"
            },
            {
              "type": "null"
            }
          ]
        },
        "commit_id": {
          "$ref": "#/$defs/CommitId"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "hypothesis_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/HypothesisId"
            },
            {
              "type": "null"
            }
          ]
        },
        "logical_record_id": {
          "$ref": "#/$defs/LogicalRecordId"
        },
        "previous_record_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecordId"
            },
            {
              "type": "null"
            }
          ]
        },
        "record_id": {
          "$ref": "#/$defs/RecordId"
        },
        "record_type": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Record Type",
          "type": "string"
        },
        "revision_number": {
          "minimum": 1,
          "title": "Revision Number",
          "type": "integer"
        },
        "schema_version": {
          "pattern": "^[1-9][0-9]*\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Schema Version",
          "type": "string"
        },
        "workspace_id": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "record_id",
        "logical_record_id",
        "record_type",
        "schema_version",
        "revision_number",
        "previous_record_id",
        "created_at",
        "analysis_id",
        "workspace_id",
        "commit_id",
        "hypothesis_id",
        "attempt_id"
      ],
      "title": "RecordMeta",
      "type": "object"
    },
    "Restriction": {
      "additionalProperties": false,
      "properties": {
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/StoredDataRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "fact_refs": {
          "items": {
            "$ref": "#/$defs/CodeFactRef"
          },
          "title": "Fact Refs",
          "type": "array"
        },
        "restriction_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Restriction Id",
          "type": "string"
        },
        "statement": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "restriction_id",
        "statement",
        "fact_refs",
        "evidence_refs"
      ],
      "title": "Restriction",
      "type": "object"
    },
    "StoredDataId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "StoredDataId",
      "type": "string"
    },
    "StoredDataRef": {
      "additionalProperties": false,
      "properties": {
        "commit_id": {
          "$ref": "#/$defs/CommitId"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "data_kind": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Data Kind",
          "type": "string"
        },
        "record_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecordId"
            },
            {
              "type": "null"
            }
          ]
        },
        "stored_data_id": {
          "$ref": "#/$defs/StoredDataId"
        },
        "workspace_id": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "stored_data_id",
        "data_kind",
        "content_hash",
        "workspace_id",
        "commit_id",
        "record_id"
      ],
      "title": "StoredDataRef",
      "type": "object"
    },
    "WorkspaceId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "WorkspaceId",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "admission_decision_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/StoredDataRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "commit_id": {
      "$ref": "#/$defs/CommitId"
    },
    "description": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Description",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/StoredDataRef"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "inputs": {
      "items": {
        "$ref": "#/$defs/PrimitiveDraft"
      },
      "title": "Inputs",
      "type": "array"
    },
    "meta": {
      "$ref": "#/$defs/RecordMeta"
    },
    "primitive_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Primitive Id",
      "type": "string"
    },
    "restrictions": {
      "items": {
        "$ref": "#/$defs/Restriction"
      },
      "title": "Restrictions",
      "type": "array"
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/PrimitiveDraft"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_hypothesis_id": {
      "$ref": "#/$defs/HypothesisId"
    },
    "source_verification_ref": {
      "$ref": "#/$defs/StoredDataRef"
    },
    "technical_review_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/StoredDataRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "workspace_id": {
      "$ref": "#/$defs/WorkspaceId"
    }
  },
  "required": [
    "meta",
    "primitive_id",
    "workspace_id",
    "commit_id",
    "inputs",
    "result",
    "restrictions",
    "source_hypothesis_id",
    "source_verification_ref",
    "technical_review_ref",
    "admission_decision_ref",
    "evidence_refs",
    "description"
  ],
  "title": "Primitive",
  "type": "object"
}
