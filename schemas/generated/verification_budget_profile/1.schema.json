{
  "$defs": {
    "AnalysisId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "AnalysisId",
      "type": "string"
    },
    "AttemptId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "AttemptId",
      "type": "string"
    },
    "CommitId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "CommitId",
      "type": "string"
    },
    "HypothesisId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "HypothesisId",
      "type": "string"
    },
    "LogicalRecordId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "LogicalRecordId",
      "type": "string"
    },
    "ProfileStatus": {
      "enum": [
        "DRAFT",
        "ACTIVE",
        "RETIRED"
      ],
      "title": "ProfileStatus",
      "type": "string"
    },
    "RecordId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "RecordId",
      "type": "string"
    },
    "RecordMeta": {
      "additionalProperties": false,
      "properties": {
        "analysis_id": {
          "$ref": "#/$defs/AnalysisId"
        },
        "attempt_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/AttemptId"
            },
            {
              "type": "null"
            }
          ]
        },
        "commit_id": {
          "$ref": "#/$defs/CommitId"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "hypothesis_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/HypothesisId"
            },
            {
              "type": "null"
            }
          ]
        },
        "logical_record_id": {
          "$ref": "#/$defs/LogicalRecordId"
        },
        "previous_record_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecordId"
            },
            {
              "type": "null"
            }
          ]
        },
        "record_id": {
          "$ref": "#/$defs/RecordId"
        },
        "record_type": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Record Type",
          "type": "string"
        },
        "revision_number": {
          "minimum": 1,
          "title": "Revision Number",
          "type": "integer"
        },
        "schema_version": {
          "pattern": "^[1-9][0-9]*\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Schema Version",
          "type": "string"
        },
        "workspace_id": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "record_id",
        "logical_record_id",
        "record_type",
        "schema_version",
        "revision_number",
        "previous_record_id",
        "created_at",
        "analysis_id",
        "workspace_id",
        "commit_id",
        "hypothesis_id",
        "attempt_id"
      ],
      "title": "RecordMeta",
      "type": "object"
    },
    "WorkspaceId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "WorkspaceId",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "max_llm_calls_per_verification": {
      "minimum": 0,
      "title": "Max Llm Calls Per Verification",
      "type": "integer"
    },
    "max_parallel_evidence_calls": {
      "minimum": 0,
      "title": "Max Parallel Evidence Calls",
      "type": "integer"
    },
    "max_retries_per_work": {
      "minimum": 0,
      "title": "Max Retries Per Work",
      "type": "integer"
    },
    "max_verification_elapsed_ms": {
      "minimum": 0,
      "title": "Max Verification Elapsed Ms",
      "type": "integer"
    },
    "max_work_per_verification": {
      "minimum": 0,
      "title": "Max Work Per Verification",
      "type": "integer"
    },
    "meta": {
      "$ref": "#/$defs/RecordMeta"
    },
    "profile_key": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Profile Key",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ProfileStatus"
    }
  },
  "required": [
    "meta",
    "profile_key",
    "max_verification_elapsed_ms",
    "max_work_per_verification",
    "max_llm_calls_per_verification",
    "max_retries_per_work",
    "max_parallel_evidence_calls",
    "status"
  ],
  "title": "VerificationBudgetProfile",
  "type": "object"
}
