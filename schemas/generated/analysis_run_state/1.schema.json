{
  "$defs": {
    "AnalysisId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "AnalysisId",
      "type": "string"
    },
    "BudgetScopeRef": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunStoredDataRef"
        },
        {
          "$ref": "#/$defs/StoredDataRef"
        }
      ]
    },
    "CommitId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "CommitId",
      "type": "string"
    },
    "LogicalRecordId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "LogicalRecordId",
      "type": "string"
    },
    "ProgramId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "ProgramId",
      "type": "string"
    },
    "Purpose": {
      "enum": [
        "PRODUCTION",
        "EVALUATION"
      ],
      "title": "Purpose",
      "type": "string"
    },
    "RecordId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "RecordId",
      "type": "string"
    },
    "RunMeta": {
      "additionalProperties": false,
      "properties": {
        "analysis_id": {
          "$ref": "#/$defs/AnalysisId"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "logical_record_id": {
          "$ref": "#/$defs/LogicalRecordId"
        },
        "previous_record_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecordId"
            },
            {
              "type": "null"
            }
          ]
        },
        "record_id": {
          "$ref": "#/$defs/RecordId"
        },
        "record_type": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Record Type",
          "type": "string"
        },
        "revision_number": {
          "minimum": 1,
          "title": "Revision Number",
          "type": "integer"
        },
        "schema_version": {
          "pattern": "^[1-9][0-9]*\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "logical_record_id",
        "record_type",
        "schema_version",
        "revision_number",
        "previous_record_id",
        "created_at",
        "analysis_id"
      ],
      "title": "RunMeta",
      "type": "object"
    },
    "RunStoredDataRef": {
      "additionalProperties": false,
      "properties": {
        "analysis_id": {
          "$ref": "#/$defs/AnalysisId"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "data_kind": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Data Kind",
          "type": "string"
        },
        "record_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecordId"
            },
            {
              "type": "null"
            }
          ]
        },
        "stored_data_id": {
          "$ref": "#/$defs/StoredDataId"
        }
      },
      "required": [
        "stored_data_id",
        "data_kind",
        "content_hash",
        "analysis_id",
        "record_id"
      ],
      "title": "RunStoredDataRef",
      "type": "object"
    },
    "StoredDataId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "StoredDataId",
      "type": "string"
    },
    "StoredDataRef": {
      "additionalProperties": false,
      "properties": {
        "commit_id": {
          "$ref": "#/$defs/CommitId"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "data_kind": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Data Kind",
          "type": "string"
        },
        "record_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecordId"
            },
            {
              "type": "null"
            }
          ]
        },
        "stored_data_id": {
          "$ref": "#/$defs/StoredDataId"
        },
        "workspace_id": {
          "$ref": "#/$defs/WorkspaceId"
        }
      },
      "required": [
        "stored_data_id",
        "data_kind",
        "content_hash",
        "workspace_id",
        "commit_id",
        "record_id"
      ],
      "title": "StoredDataRef",
      "type": "object"
    },
    "WorkspaceId": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "WorkspaceId",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "analysis_result_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunStoredDataRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "budget_binding_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/StoredDataRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "commit_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/CommitId"
        },
        {
          "type": "null"
        }
      ]
    },
    "elapsed_ms": {
      "minimum": 0,
      "title": "Elapsed Ms",
      "type": "integer"
    },
    "eval_config_refs": {
      "items": {
        "$ref": "#/$defs/BudgetScopeRef"
      },
      "title": "Eval Config Refs",
      "type": "array"
    },
    "execution_budget_profile_ref": {
      "$ref": "#/$defs/RunStoredDataRef"
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Finished At"
    },
    "meta": {
      "$ref": "#/$defs/RunMeta"
    },
    "program_id": {
      "$ref": "#/$defs/ProgramId"
    },
    "purpose": {
      "$ref": "#/$defs/Purpose"
    },
    "run_policy_state_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/StoredDataRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "enum": [
        "RUNNING",
        "COMPLETE",
        "PARTIAL",
        "FAILED",
        "CANCELLED"
      ],
      "title": "Status",
      "type": "string"
    },
    "workspace_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/WorkspaceId"
        },
        {
          "type": "null"
        }
      ]
    },
    "workspace_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunStoredDataRef"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "meta",
    "purpose",
    "eval_config_refs",
    "program_id",
    "execution_budget_profile_ref",
    "budget_binding_ref",
    "workspace_id",
    "commit_id",
    "workspace_ref",
    "run_policy_state_ref",
    "status",
    "analysis_result_ref",
    "started_at",
    "finished_at",
    "elapsed_ms"
  ],
  "title": "AnalysisRunState",
  "type": "object"
}
