# Default Cursor authentication is official CLI browser login (`agent login`),
# which requires no API key environment variable. Never copy login sessions.

# Optional alternative for Cursor SDK API-key mode only. Create your own key in
# Cursor Dashboard > API Keys (or a Team service-account key); never commit it.
CURSOR_API_KEY=

# Optional fallback credential when fallback_provider = "openai".
OPENAI_API_KEY=

# Optional setup convenience. Use only an ID printed by `sastsimi cursor-models`.
SASTSIMI_LLM_PROVIDER=cursor
SASTSIMI_CURSOR_MODEL=
